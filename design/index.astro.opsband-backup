---
import Base from '../layouts/Base.astro';
import Hero from '../components/astro/home/Hero.astro';
import NetworkGraph from '../components/astro/NetworkGraph.astro';
import FlowDiagram from '../components/astro/FlowDiagram.astro';
import ThreatMap from '../components/astro/ThreatMap.astro';
import About from '../components/astro/home/About.astro';
import StatsStrip from '../components/astro/home/StatsStrip.astro';
import MeetPlatform from '../components/astro/home/MeetPlatform.astro';
import HowItWorks from '../components/astro/home/HowItWorks.astro';
import Products from '../components/astro/home/Products.astro';
import Integrations from '../components/astro/home/Integrations.astro';
---

<Base
  title="AquaSecure.ai — AI-Powered Cloud Native Cybersecurity"
  description="AquaSecure stops cyber attacks before they happen — AI threat detection, container security, runtime protection and automated response from code to cloud to prompt."
  ogTitle="AquaSecure.ai — AI-Powered Cybersecurity"
  ogDescription="The pioneer in AI-native cloud security. Stop threats in under 50ms."
>
  <Hero />
  <About />
  <StatsStrip />

  {/* Live platform console — the animated technical sections, framed as one dark band */}
  <div class="ops-band">
    <div class="ops-band-head wrap text-center">
      <span class="badge">The platform, live</span>
      <h2 class="font-black tracking-tight" style="font-size:clamp(28px,3.6vw,46px);color:var(--text)">
        Watch AquaSecure <span class="tg">work in real time</span>
      </h2>
    </div>
    <NetworkGraph />
    <FlowDiagram />
    <ThreatMap />
  </div>

  <MeetPlatform />
  <HowItWorks />
  <Products />
  <Integrations />
</Base>
