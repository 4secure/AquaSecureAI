---
// Aqua Secure Portal platform page — implements the Claude Design file "AquaSecure Portal.dc.html".
// Centred hero with a subscription tile strip, then module rows, a role/permission matrix, and a
// tenant switcher. Nav, Footer and the site utilities are shared with the rest of the site.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Alternating gradient depth per tile, as the design computes from the index.
const tiles = [
  { name: 'GRC', state: '93 controls' },
  { name: 'SOC', state: '2 open cases' },
  { name: 'Aqua SIEM', state: 'Ingesting' },
  { name: 'Threat Intel', state: 'Feeds current' },
  { name: 'Assets', state: '1,847 tracked' },
  { name: 'Dark Web', state: '1 finding' },
  { name: 'Phishbot', state: 'Campaign live' },
].map((t, i) => ({ ...t, from: i % 2 ? '0.72' : '0.62' }));

const modules = [
  {
    icon: 'compliance',
    name: 'Compliance',
    kind: 'Product',
    desc: 'Control status, evidence, policies, and audit reporting from Aqua GRC.',
  },
  {
    icon: 'security-operations',
    name: 'Operations',
    kind: 'Product',
    desc: 'Live incidents, case history, and response actions from Aqua SOC and SIEM.',
  },
  {
    icon: 'assets-identity',
    name: 'Assets & Identity',
    kind: 'Product',
    desc: 'The live inventory, ownership records, and per-asset risk scoring.',
  },
  {
    icon: 'threat-intelligence',
    name: 'Intelligence',
    kind: 'Platform',
    desc: 'Indicators, actor profiles, and briefings served from Aqua TIP.',
  },
  {
    icon: 'employee-security',
    name: 'People',
    kind: 'Product',
    desc: 'Phishing simulation results, training completion, and human risk scores.',
  },
  {
    icon: 'digital-exposure',
    name: 'Service',
    kind: 'Managed',
    desc: 'Tickets, service reviews, and your named lead for every managed service.',
  },
];

const roles = [
  { name: 'Security lead', who: 'Runs the programme', cells: ['Full', 'Full', 'Full', 'Full'] },
  { name: 'Analyst', who: 'Works incidents daily', cells: ['Full', 'Full', 'Read', 'None'] },
  { name: 'Compliance manager', who: 'Owns certification', cells: ['Read', 'Read', 'Full', 'None'] },
  { name: 'External auditor', who: 'Time-boxed access', cells: ['None', 'None', 'Read', 'None'] },
  { name: 'Executive', who: 'Board reporting only', cells: ['Read', 'None', 'None', 'None'] },
];

// Permission chip tones, keyed off the grant level.
const cellTone = {
  Full: 'bg-brand text-white',
  Read: 'bg-brand/[0.14] text-[#2A4A92]',
  None: 'border border-line text-muted',
};

const tenancy = [
  'Each tenant keeps separate data, users, and retention settings.',
  'Roll-up dashboards compare posture across every business you run.',
  'Switch tenant without logging out or holding a second set of credentials.',
  'Per-tenant reporting for clients, subsidiaries, and regulators.',
];

const tenants = [
  { name: 'Group holding', detail: 'Roll-up across 3 tenants', state: 'Active' },
  { name: 'Manufacturing division', detail: '1,240 assets · ISO 27001', state: 'Healthy' },
  { name: 'Financial services arm', detail: '480 assets · PCI-DSS', state: '2 alerts' },
  { name: 'Client: Northwind', detail: 'Managed SIEM · 24/7', state: 'Healthy' },
].map((t) => ({ ...t, active: t.state === 'Active', attention: t.state === '2 alerts' }));

const permCols = 'grid-cols-[minmax(200px,1.4fr)_repeat(4,minmax(0,1fr))]';
---

<Base
  title="Aqua Secure Portal — Aqua Secure AI"
  description="Aqua Secure Portal is the front door to every product you subscribe to. One identity, one permission model, one place your team, your auditors, and your service provider all work from."
>
  <Nav />

  <!-- ============ HERO ============ -->
  <section id="top" class="relative isolate overflow-hidden">
    <div class="hero-grad absolute inset-0 -z-10"></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-[14%] bg-[linear-gradient(to_bottom,transparent_0%,rgba(255,255,255,0.5)_45%,#ffffff_100%)]"
    >
    </div>

    <div class="wrap relative z-[1] pt-[176px] text-center" data-reveal-group="90" data-reveal-now>
      <span
        class="inline-flex items-center gap-2.5 rounded-full border border-white py-[7px] pl-3 pr-4 text-eyebrow font-bold uppercase tracking-[0.06em] text-white"
      >
        <span
          data-motion="dot"
          class="h-[7px] w-[7px] rounded-full bg-white shadow-[0_0_0_4px_rgba(255,255,255,0.25)] [animation:dotPulse_2.4s_ease-in-out_infinite]"
        ></span>
        Platform
      </span>

      <h1
        class="mx-auto mt-[22px] max-w-[900px] text-balance font-display text-[clamp(38px,5vw,64px)] font-bold leading-[1.08] tracking-[-0.025em] text-white"
      >
        One login for your entire security programme
      </h1>
      <p class="mx-auto mt-5 max-w-[640px] text-pretty text-[clamp(16px,1.4vw,20px)] font-medium leading-[1.4] text-white">
        Aqua Secure Portal is the front door to every product you subscribe to. One identity, one permission model, one
        place your team, your auditors, and your service provider all work from.
      </p>

      <div class="mt-[30px] flex flex-wrap items-center justify-center gap-3">
        <a href="#demo" class="btn-light">Take A Tour</a>
        <a href="#modules" class="btn-ghost">See What Is Inside</a>
      </div>
    </div>

    <!-- Subscription strip. The 1px grid gap plus a translucent backdrop draws the hairlines
         between tiles, so each tile only paints its own gradient. -->
    <div class="wrap relative z-[1] mt-16 pb-[130px]" data-reveal data-reveal-now data-reveal-delay="240">
      <div class="flex items-center gap-3.5 pb-4">
        <span class="text-eyebrow font-bold uppercase tracking-[0.12em] text-white">Your subscription, on one screen</span>
        <span class="h-px flex-1 bg-white/40"></span>
      </div>

      <div
        class="grid gap-px overflow-hidden rounded-[14px] border border-[rgba(42,74,146,0.45)] bg-white/[0.35] shadow-[0_14px_34px_rgba(11,22,48,0.18)] [grid-template-columns:repeat(auto-fit,minmax(150px,1fr))]"
      >
        {
          tiles.map((t) => (
            <div
              class="flex flex-col gap-[7px] px-[18px] py-5"
              style={`background:linear-gradient(160deg,rgba(42,74,146,${t.from}) 0%,rgba(42,74,146,0.44) 100%)`}
            >
              <span class="h-2 w-2 rounded-full bg-brand shadow-[0_0_0_3px_rgba(79,194,187,0.28)]" />
              <span class="font-display text-small font-semibold leading-[1.2] text-white">{t.name}</span>
              <span class="text-[13px] font-semibold text-white/[0.78]">{t.state}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ INSIDE THE PORTAL ============ -->
  <section id="modules" class="section bg-white">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <span class="eyebrow">Inside The Portal</span>
          <h2
            class="mt-4 font-display text-[clamp(30px,3.6vw,46px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
          >
            Everything in one workspace
          </h2>
        </div>
        <p class="max-w-[400px] text-pretty text-[17px] font-medium leading-[1.45] text-muted">
          Modules appear as you subscribe to them. Nothing to install, no separate consoles to keep in sync.
        </p>
      </div>

      <div class="mt-10 flex flex-col" data-reveal-group="60">
        {
          modules.map((m) => (
            <div class="grid grid-cols-[44px_minmax(0,1fr)] items-center gap-4 border-t border-line py-[22px] md:grid-cols-[64px_220px_minmax(0,1fr)_132px] md:gap-6">
              <img
                src={`/icons/${m.icon}.svg`}
                alt=""
                aria-hidden="true"
                width="44"
                height="44"
                class="block h-11 w-11"
              />
              <span class="font-display text-[21px] font-semibold leading-[1.2] tracking-[-0.01em] text-ink">
                {m.name}
              </span>
              <span class="col-span-2 text-pretty text-small font-medium leading-[1.45] text-muted md:col-span-1">
                {m.desc}
              </span>
              <span
                class:list={[
                  'justify-self-start rounded-full px-3 py-[5px] text-[11px] font-bold uppercase tracking-[0.07em] text-[#2A4A92] md:justify-self-end',
                  m.kind === 'Managed' ? 'bg-[#2A4A92]/10' : 'bg-brand/[0.14]',
                ]}
              >
                {m.kind}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ACCESS CONTROL ============ -->
  <section id="access" class="section section-tint">
    <div class="wrap">
      <div class="max-w-[660px]" data-reveal>
        <span class="eyebrow">Access Control</span>
        <h2
          class="mt-4 font-display text-[clamp(30px,3.6vw,46px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
        >
          The right people see the right things
        </h2>
        <p class="mt-[18px] text-pretty text-[17px] font-medium leading-[1.5] text-muted">
          Roles are defined once and apply across every module, so giving an auditor read-only evidence access does not
          mean handing over your SOC console.
        </p>
      </div>

      <div class="mt-11 overflow-x-auto rounded-[14px] border border-line bg-white" data-reveal>
        <div class="min-w-[720px]">
          <div
            class:list={[
              'grid gap-4 bg-brand/[0.08] px-6 py-4 text-eyebrow font-bold uppercase tracking-[0.08em] text-[#2A4A92]',
              permCols,
            ]}
          >
            <span>Role</span><span>Dashboards</span><span>Incidents</span><span>Evidence</span><span>Settings</span>
          </div>

          {
            roles.map((r) => (
              <div class:list={['grid items-center gap-4 border-t border-line px-6 py-[18px]', permCols]}>
                <div class="flex flex-col gap-[3px]">
                  <span class="font-display text-[17px] font-semibold text-ink">{r.name}</span>
                  <span class="text-[14px] font-medium text-muted">{r.who}</span>
                </div>
                {r.cells.map((c) => (
                  <span
                    class:list={[
                      'inline-flex items-center justify-center justify-self-start rounded-full px-3 py-[5px] text-eyebrow font-bold uppercase tracking-[0.06em]',
                      cellTone[c],
                    ]}
                  >
                    {c}
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MULTI-TENANCY ============ -->
  <section id="tenancy" class="section bg-white">
    <div class="wrap">
      <div class="grid items-start gap-14 [grid-template-columns:repeat(auto-fit,minmax(340px,1fr))]" data-reveal-group="110">
        <div>
          <span class="eyebrow">Multi-Tenancy</span>
          <h2
            class="mt-4 font-display text-[clamp(28px,3.2vw,42px)] font-semibold leading-[1.12] tracking-[-0.02em] text-ink"
          >
            Built for groups and service providers
          </h2>
          <p class="mt-[18px] text-pretty text-[17px] font-medium leading-[1.5] text-muted">
            Run several businesses, subsidiaries, or client estates from one login. Each tenant keeps its own data,
            users, and reporting, with a roll-up view across all of them.
          </p>

          <ul class="mt-[26px] flex flex-col gap-3.5">
            {
              tenancy.map((p) => (
                <li class="flex items-start gap-3 border-b border-line pb-3.5">
                  <span class="mt-[7px] h-2 w-2 shrink-0 rounded-[2px] bg-brand" />
                  <span class="text-small font-medium leading-[1.45] text-muted">{p}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <div class="flex items-center gap-3.5">
            <span class="text-eyebrow font-bold uppercase tracking-[0.12em] text-[#2A4A92]">Tenant switcher</span>
            <span class="h-px flex-1 bg-line"></span>
          </div>

          <div class="mt-[18px] flex flex-col gap-3">
            {
              tenants.map((t) => (
                <div
                  class:list={[
                    'flex items-center justify-between gap-4 rounded-xl border px-5 py-[18px]',
                    t.active ? 'border-brand bg-brand/[0.06]' : 'border-line bg-white',
                  ]}
                >
                  <div class="flex flex-col gap-[3px]">
                    <span class="font-display text-body font-semibold tracking-[-0.01em] text-ink">{t.name}</span>
                    <span class="text-[14px] font-medium text-muted">{t.detail}</span>
                  </div>
                  <span
                    class:list={[
                      'shrink-0 rounded-full px-3 py-[5px] text-eyebrow font-bold uppercase tracking-[0.06em] text-[#2A4A92]',
                      t.attention ? 'bg-[#2A4A92]/[0.12]' : 'bg-brand/[0.14]',
                    ]}
                  >
                    {t.state}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="demo" class="section bg-white">
    <div class="wrap">
      <div
        data-reveal
        class="flex flex-col items-center rounded-[20px] bg-[url('/background/background.svg')] bg-[length:100%_100%] bg-no-repeat px-6 py-16 text-center md:px-16 md:py-[80px]"
      >
        <span
          class="inline-block rounded-full border-[0.8px] border-white px-[14px] py-1 text-eyebrow font-bold uppercase tracking-[0.04em] text-white"
        >
          Get Started
        </span>
        <h2
          class="mt-4 font-display text-[clamp(28px,3.6vw,48px)] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          Stop Logging Into Five Consoles
        </h2>
        <p class="mx-auto mt-[18px] max-w-[720px] text-body font-medium text-white">
          One identity, one permission model, and every product you subscribe to in a single workspace.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="#demo" class="btn-light">Take A Tour</a>
          <a href="#contact" class="btn-ghost">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
