---
import Base from '../../layouts/Base.astro';
import SolutionDetail from '../../components/astro/pages/SolutionDetail.astro';
import { SOLUTIONS } from '../../data/solutions.js';

export function getStaticPaths() {
  return Object.entries(SOLUTIONS).map(([slug, s]) => ({
    params: { slug },
    props: { name: s.name, description: s.sub || s.tagline || '', image: s.img || '/images/dashboard-hero.png' },
  }));
}

const { slug } = Astro.params;
const { name, description, image } = Astro.props;
---

<Base title={`${name} — Aqua Secure AI`} description={description} ogImage={image}>
  <SolutionDetail slug={slug} />
</Base>
