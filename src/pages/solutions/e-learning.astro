---
// E-learning solution page — implements the Claude Design file "AquaSecure E-learning.dc.html".
// Same architecture as the other solution pages. Two details differ from its siblings and are
// deliberate: the hero LIVE indicator is white here rather than brand teal, and the posture
// section uses the campaigns screenshot instead of the SIEM diagram.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const included = ['Course library', 'Auto-assignment', 'Completion tracking', 'Audit evidence'];

// Hero snapshot of the quarter. The `Escalated` row is the one needing action, so it carries the
// live treatment (teal border, brighter gradient, filled chip).
const quarter = [
  {
    label: 'ASSIGNED',
    state: 'Active',
    value: '1,240',
    detail: 'staff enrolled\nacross 14 curricula',
    note: 'Baseline track for everyone, plus finance, developer, and executive modules on top.',
  },
  {
    label: 'OUTSTANDING',
    state: 'Escalated',
    value: '38',
    detail: 'past their\ndue date',
    note: 'Reminders sent and line managers notified; two teams account for most of the backlog.',
  },
  {
    label: 'COMPLETED',
    state: 'Evidenced',
    value: '92%',
    detail: 'finished with\na passing score',
    note: 'Median completion time nine minutes, with certificates held per person for audit.',
  },
].map((x, i) => ({ ...x, live: x.state === 'Escalated', indent: i * 22 }));

const coverage = [
  {
    icon: 'employee-security',
    name: 'Phishing & Social Engineering',
    controls: '6 modules',
    note: 'Spotting lures, pretexts, and the requests worth a second phone call.',
  },
  {
    icon: 'assets-identity',
    name: 'Passwords & MFA',
    controls: '4 modules',
    note: 'Password managers, passkeys, and why approval prompts get abused.',
  },
  {
    icon: 'compliance',
    name: 'Data Protection',
    controls: '5 modules',
    note: 'Handling personal data, retention, and reporting a suspected breach.',
  },
  {
    icon: 'digital-exposure',
    name: 'Remote & Device Security',
    controls: '4 modules',
    note: 'Home networks, public wifi, lost devices, and shadow IT.',
  },
  {
    icon: 'security-operations',
    name: 'Incident Reporting',
    controls: '3 modules',
    note: 'What to report, to whom, and why speed matters more than certainty.',
  },
  {
    icon: 'threat-intelligence',
    name: 'Fraud & Payments',
    controls: '4 modules',
    note: 'Invoice fraud and payment-change requests, aimed at finance teams.',
  },
  {
    icon: 'observability',
    name: 'Role-Specific',
    controls: 'Developers, HR, execs',
    note: 'Secure coding, recruitment fraud, and executive targeting tracks.',
  },
  {
    icon: 'ai-agents',
    name: 'AI & Emerging Threats',
    controls: 'Updated quarterly',
    note: 'Deepfake voice requests, AI-written lures, and safe use of AI tools.',
  },
];

const features = [
  {
    icon: 'observability',
    title: 'Short, Specific Modules',
    desc: 'Most courses run under ten minutes, built around decisions people actually face rather than definitions.',
  },
  {
    icon: 'ai-agents',
    title: 'Automatic Assignment',
    desc: 'Curricula assigned by role, department, and start date, with new joiners enrolled from your directory automatically.',
  },
  {
    icon: 'employee-security',
    title: 'Reminders Without Chasing',
    desc: 'Due dates, escalating reminders, and optional line-manager visibility handled by the platform, not your inbox.',
  },
  {
    icon: 'compliance',
    title: 'Audit-Ready Evidence',
    desc: 'Completion records and quiz scores per person, exportable and mapped to ISO 27001, GDPR, and PCI-DSS controls.',
  },
  {
    icon: 'digital-exposure',
    title: 'Linked To Simulations',
    desc: 'Phishing results feed enrolment, so anyone who clicks is assigned the module that addresses what they missed.',
  },
  {
    icon: 'security-operations',
    title: 'Localised Content',
    desc: 'Modules delivered in your staff languages, with content refreshed as threats and regulations change.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Enrol',
    open: true,
    body: 'Staff are synced from your directory and grouped by role, department, and location, so nobody is added or removed by hand.',
  },
  {
    num: '02',
    title: 'Assign',
    open: false,
    body: 'Each group receives a curriculum with due dates — a baseline track for everyone, plus role-specific modules on top.',
  },
  {
    num: '03',
    title: 'Track',
    open: false,
    body: 'Progress, quiz scores, and reminders are handled automatically, with escalation to line managers when a due date passes.',
  },
  {
    num: '04',
    title: 'Evidence',
    open: false,
    body: 'Completion records are held per person and exported as audit evidence, mapped to the awareness controls in your frameworks.',
  },
];

const riskPoints = [
  'Completion, scores, and dates recorded per person, team, and department.',
  'Outstanding assignments visible before a due date, not after the audit.',
  'Evidence exports mapped to ISO 27001, GDPR, and PCI-DSS training controls.',
  'Phishing simulation results and training history sit in one human risk view.',
];

const useCases = ['Annual Awareness', 'New Starter Onboarding', 'Audit Evidence', 'Role-Based Training'];

const cardClass =
  'flex flex-col rounded-xl border border-line bg-white transition duration-200 ease-out hover:-translate-y-1 hover:border-brand hover:shadow-card-open';
---

<Base
  title="E-learning — Aqua Secure AI"
  description="Short, role-relevant security awareness modules assigned automatically, tracked to completion, and mapped to the awareness controls your auditors ask about."
>
  <Nav />

  <!-- ============ HERO ============ -->
  <section id="top" class="relative isolate overflow-hidden">
    <div class="hero-grad absolute inset-0 -z-10"></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[11%] bg-[linear-gradient(to_bottom,transparent_0%,rgba(255,255,255,0.5)_45%,#ffffff_100%)]"
    >
    </div>

    <div class="wrap relative z-[1] pb-[120px] pt-[170px]">
      <div class="grid items-center gap-16 [grid-template-columns:repeat(auto-fit,minmax(400px,1fr))]">
        <div data-reveal-group="90" data-reveal-now>
          <span
            class="inline-flex items-center gap-2.5 rounded-full border border-white py-[7px] pl-3 pr-4 text-eyebrow font-bold uppercase tracking-[0.06em] text-white"
          >
            <span
              data-motion="dot"
              class="h-[7px] w-[7px] rounded-full bg-white shadow-[0_0_0_4px_rgba(255,255,255,0.25)] [animation:dotPulse_2.4s_ease-in-out_infinite]"
            ></span>
            Security Awareness E-learning
          </span>

          <h1
            class="mt-[22px] text-balance font-display text-[clamp(38px,4.8vw,62px)] font-bold leading-[1.08] tracking-[-0.025em] text-white"
          >
            Training your staff finish, and remember
          </h1>

          <p
            class="mt-[22px] max-w-[560px] text-pretty text-[clamp(16px,1.4vw,20px)] font-medium leading-[1.45] text-white"
          >
            Short, role-relevant modules assigned automatically, tracked to completion, and mapped to the awareness
            controls your auditors ask about — no all-day annual session nobody retains.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#demo" class="btn-light">Browse The Course Library</a>
            <a href="#how" class="btn-ghost">How Assignment Works</a>
          </div>

          <div class="mt-[38px] border-t border-white/30 pt-[26px]">
            <span class="text-eyebrow font-bold uppercase tracking-[0.12em] text-white">What we manage</span>
            <div class="mt-3.5 flex flex-wrap gap-2.5">
              {
                included.map((inc) => (
                  <span class="whitespace-nowrap rounded-lg border border-white/50 px-[13px] py-[7px] text-[14px] font-semibold text-white">
                    {inc}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <div data-reveal data-reveal-now data-reveal-delay="240">
          <div class="mb-5 flex items-center gap-3">
            <span class="text-eyebrow font-bold uppercase tracking-[0.12em] text-white">This quarter at a glance</span>
            <span class="h-px flex-1 bg-white/[0.34]"></span>
            <span class="inline-flex items-center gap-[7px] text-eyebrow font-bold tracking-[0.06em] text-white">
              <span
                data-motion="dot"
                class="h-[7px] w-[7px] rounded-full bg-white [animation:dotPulse_2.4s_ease-in-out_infinite]"
              ></span>
              LIVE
            </span>
          </div>

          <div class="flex flex-col gap-3.5">
            {
              quarter.map((q) => (
                <div
                  style={`margin-left:${q.indent}px`}
                  class:list={[
                    'relative rounded-[14px] border px-[22px] py-5 shadow-[0_12px_30px_rgba(11,22,48,0.16)]',
                    q.live
                      ? 'border-[rgba(79,194,187,0.75)] bg-[linear-gradient(135deg,rgba(42,74,146,0.82)_0%,rgba(79,194,187,0.62)_100%)]'
                      : 'border-[rgba(42,74,146,0.4)] bg-[linear-gradient(135deg,rgba(42,74,146,0.68)_0%,rgba(42,74,146,0.42)_100%)]',
                  ]}
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-display text-[15px] font-bold tracking-[0.02em] text-white">{q.label}</span>
                    <span
                      class:list={[
                        'shrink-0 rounded-full px-[11px] py-1 text-[11px] font-bold uppercase tracking-[0.09em]',
                        q.live ? 'bg-brand text-white' : 'border border-white/[0.45] text-white/[0.85]',
                      ]}
                    >
                      {q.state}
                    </span>
                  </div>

                  <div class="mt-4 flex items-end gap-[18px]">
                    <span class="font-display text-[40px] font-bold leading-[0.9] tracking-[-0.03em] text-white">
                      {q.value}
                    </span>
                    <span class="whitespace-pre-line pb-[3px] text-[14px] font-semibold leading-[1.3] text-white/[0.82]">
                      {q.detail}
                    </span>
                  </div>

                  <p class="mt-3 text-pretty text-[14px] font-medium leading-[1.4] text-white/[0.72]">{q.note}</p>
                </div>
              ))
            }
          </div>

          <p class="mt-5 text-[15px] font-semibold leading-[1.4] text-white">
            Completion evidence exports straight into your audit pack.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COURSE LIBRARY ============ -->
  <section id="coverage" class="section bg-white">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <span class="eyebrow">Course Library</span>
        <h2 class="mt-4 h2">Every Topic.<br />In Ten Minutes Or Less.</h2>
        <p class="sub mx-auto mt-5 max-w-[680px]">
          Modules written for working people, not for compliance forms — short, specific, and refreshed as the threats
          and regulations change.
        </p>
      </div>

      <div
        class="mt-[60px] grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]"
        data-reveal-group="60"
      >
        {
          coverage.map((f) => (
            <article class:list={[cardClass, 'gap-5 p-5']}>
              <img
                src={`/icons/${f.icon}.svg`}
                alt=""
                aria-hidden="true"
                width="60"
                height="60"
                class="mx-auto block h-[60px] w-[60px]"
              />
              <div class="flex flex-col gap-3 text-center">
                <h3 class="font-display text-h3 font-bold text-ink">{f.name}</h3>
                <p class="text-pretty text-small font-medium text-muted">{f.note}</p>
                <span class="eyebrow self-center">{f.controls}</span>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#demo" class="btn-outline whitespace-nowrap">Ask About A Custom Module</a>
      </div>
    </div>
  </section>

  <!-- ============ KEY FEATURES ============ -->
  <section class="section section-tint">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <span class="eyebrow">Key Features</span>
        <h2 class="mt-4 h2">Content, Assignment And Evidence<br />In One Platform.</h2>
      </div>

      <div
        class="mt-[60px] grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]"
        data-reveal-group="70"
      >
        {
          features.map((f) => (
            <article class:list={[cardClass, 'gap-[18px] p-6']}>
              <img
                src={`/icons/${f.icon}.svg`}
                alt=""
                aria-hidden="true"
                width="52"
                height="52"
                class="block h-[52px] w-[52px]"
              />
              <div class="flex flex-col gap-2.5">
                <h3 class="font-display text-[22px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">{f.title}</h3>
                <p class="text-pretty text-small font-medium leading-[1.45] text-muted">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section id="how" class="section bg-white">
    <div class="wrap">
      <div
        class="grid items-start gap-[60px] [grid-template-columns:repeat(auto-fit,minmax(340px,1fr))]"
        data-reveal-group="110"
      >
        <div>
          <span class="eyebrow">How It Works</span>
          <h2
            class="mt-4 font-display text-[clamp(30px,3.4vw,44px)] font-semibold leading-[1.115] tracking-[-0.02em] text-ink"
          >
            From Enrolment To Audit Evidence
          </h2>
          <p class="sub mt-5 text-pretty">
            Training runs on its own once configured. People are enrolled, reminded, and recorded without your team
            chasing anyone.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#demo" class="btn-primary">Book A Content Walkthrough</a>
          </div>
        </div>

        <div class="flex flex-col gap-5">
          {
            steps.map((s) => (
              <details
                open={s.open}
                class="acc rounded-xl border-[1.5px] border-line bg-white p-[22px] open:border-brand open:shadow-card-open"
              >
                <summary class="flex items-center justify-between gap-4">
                  <span class="flex items-center gap-4">
                    <span class="inline-flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-brand/[0.12] text-small font-bold text-brand">
                      {s.num}
                    </span>
                    <span class="font-display text-h3 font-semibold text-ink">{s.title}</span>
                  </span>
                  <svg
                    class="acc-chev shrink-0 transition-transform"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m6 9 6 6 6-6"
                      stroke="#0B1630"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <div class="acc-body">
                  <p class="ml-[50px] mt-3.5 text-pretty text-small font-medium leading-[1.5] text-muted">{s.body}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMPLETION REPORTING ============ -->
  <section id="platform" class="section section-tint">
    <div class="wrap">
      <div
        class="grid items-center gap-[60px] [grid-template-columns:repeat(auto-fit,minmax(360px,1fr))]"
        data-reveal-group="110"
      >
        <div class="card">
          <img
            src="/img/campaigns.png"
            alt="Training completion records with scores, due dates and audit evidence"
            width="634"
            height="476"
            loading="lazy"
            class="block w-full rounded-lg"
          />
        </div>

        <div>
          <span class="eyebrow">Completion Reporting</span>
          <h2
            class="mt-4 font-display text-[clamp(30px,3.4vw,44px)] font-semibold leading-[1.115] tracking-[-0.02em] text-ink"
          >
            Prove Who Was Trained, And When
          </h2>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              riskPoints.map((p) => (
                <li class="flex items-start gap-3">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-0.5 shrink-0">
                    <circle cx="12" cy="12" r="10" fill="rgba(79,194,187,.14)" />
                    <path
                      d="m7.5 12.2 3 3 6-6.4"
                      stroke="#4FC2BB"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-[17px] font-medium leading-[1.45] text-muted">{p}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ USE CASES ============ -->
  <section class="section bg-white pb-0">
    <div class="wrap text-center" data-reveal>
      <span class="eyebrow">Use Cases</span>
      <h2 class="mt-4 h2">Who Uses Aqua E-learning?</h2>

      <div class="mx-auto mt-8 flex max-w-[820px] flex-wrap justify-center gap-3">
        {
          useCases.map((u) => (
            <span class="rounded-full border border-brand/35 bg-brand/[0.08] px-5 py-2.5 text-small font-semibold text-ink">
              {u}
            </span>
          ))
        }
      </div>

      <p class="mx-auto mt-7 max-w-[720px] text-pretty text-[17px] font-medium leading-[1.5] text-muted">
        E-learning is built for the people who have to evidence training — security, HR, and compliance teams who need
        completion records ready before the auditor asks.
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="demo" class="section bg-white">
    <div class="wrap">
      <div
        data-reveal
        class="flex flex-col items-center rounded-[20px] bg-[url('/background/background.svg')] bg-[length:100%_100%] bg-no-repeat px-6 py-16 text-center md:px-16 md:py-[80px]"
      >
        <span
          class="inline-block rounded-full border-[0.8px] border-white px-[14px] py-1 text-eyebrow font-bold uppercase tracking-[0.04em] text-white"
        >
          Get Started
        </span>
        <h2
          class="mt-4 font-display text-[clamp(28px,3.6vw,48px)] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          Awareness Training People Actually Finish
        </h2>
        <p class="mx-auto mt-[18px] max-w-[720px] text-body font-medium text-white">
          A full course library, automatic assignment, reminder handling, and completion evidence mapped to your
          frameworks.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="#demo" class="btn-light">Schedule A Demo</a>
          <a href="#contact" class="btn-ghost">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
