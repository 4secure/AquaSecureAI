---
// GRC product page — implements the Claude Design file "AquaSecure GRC.dc.html".
// Chrome (nav, footer), the hero gradient, glass stage, eyebrows, buttons, cards and
// accordion all reuse the utilities the landing page already defines, so this page carries
// no styling of its own beyond layout.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductHero from '../../components/ProductHero.astro';

const frameworks = [
  {
    icon: 'compliance',
    name: 'ISO 27001',
    controls: '93 controls',
    note: 'Full Annex A control mapping with evidence pulled from your connected estate.',
  },
  {
    icon: 'security-operations',
    name: 'SOC 2',
    controls: '5 criteria',
    note: 'Trust services criteria tracked continuously across the observation window.',
  },
  {
    icon: 'assets-identity',
    name: 'GDPR',
    controls: '11 chapters',
    note: 'Data protection obligations, records of processing, and subject request handling.',
  },
  {
    icon: 'employee-security',
    name: 'HIPAA',
    controls: '54 safeguards',
    note: 'Administrative, physical, and technical safeguards for protected health information.',
  },
  {
    icon: 'digital-exposure',
    name: 'PCI-DSS',
    controls: '12 requirements',
    note: 'Scoped monitoring of the cardholder data environment and its segmentation.',
  },
  {
    icon: 'observability',
    name: 'NIST',
    controls: 'CSF + 800-53',
    note: 'Posture across Identify, Protect, Detect, Respond, and Recover.',
  },
  {
    icon: 'threat-intelligence',
    name: 'CTDISR',
    controls: 'Regional baseline',
    note: 'Regulatory baseline mapped to the same controls you already evidence.',
  },
  {
    icon: 'ai-agents',
    name: 'Custom',
    controls: 'Your own controls',
    note: 'Author a framework, import controls, and reuse existing evidence.',
  },
];

const features = [
  {
    icon: 'compliance',
    title: 'Multi-Framework Support',
    desc: 'Manage GDPR, HIPAA, PCI-DSS, ISO 27001, CTDISR, and custom frameworks from a single interface.',
  },
  {
    icon: 'assets-identity',
    title: 'Automated Evidence Collection',
    desc: 'Automatically gather and organise evidence from connected systems — no manual screenshots or exports.',
  },
  {
    icon: 'observability',
    title: 'Continuous Compliance Monitoring',
    desc: 'Real-time monitoring against framework controls with instant alerts when gaps appear.',
  },
  {
    icon: 'security-operations',
    title: 'Audit-Ready Reporting',
    desc: 'Generate audit reports on-demand that map evidence to controls — reducing audit prep from weeks to hours.',
  },
  {
    icon: 'digital-exposure',
    title: 'Risk Register & Treatment',
    desc: 'Centralised risk register with treatment plans, owners, deadlines, and risk acceptance workflows.',
  },
  {
    icon: 'employee-security',
    title: 'Executive Risk Dashboards',
    desc: 'Board-level dashboards showing compliance posture, risk trends, and top remediation priorities.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Connect',
    open: true,
    body: 'Link your cloud accounts, identity provider, endpoints, and ticketing tools through the connectors platform. No agents to roll out, no rip-and-replace.',
  },
  {
    num: '02',
    title: 'Collect',
    open: false,
    body: 'Evidence is pulled on a schedule and mapped to the controls it satisfies across every framework you have enabled.',
  },
  {
    num: '03',
    title: 'Monitor',
    open: false,
    body: 'Controls are tested continuously. When a control drifts out of compliance, the owner is alerted with the failing evidence attached.',
  },
  {
    num: '04',
    title: 'Report',
    open: false,
    body: 'Export an audit package that maps evidence to controls, or share a live executive dashboard with the board.',
  },
];

const riskPoints = [
  'Register every risk with impact, likelihood, and inherent and residual scoring.',
  'Assign owners, treatment plans, and deadlines, with reminders as dates approach.',
  'Route risk acceptance through a documented approval workflow.',
  'Link risks to the controls and assets they affect for full traceability.',
];

const useCases = ['ISO 27001 Certification', 'GDPR Compliance', 'PCI-DSS Audit', 'Board Reporting'];

const cardClass =
  'flex flex-col rounded-xl border border-line bg-white transition duration-200 ease-out hover:-translate-y-1 hover:border-brand hover:shadow-card-open';
---

<Base
  title="GRC — Aqua Secure AI"
  description="Centralise governance, risk, and compliance in one platform — with real-time audit readiness, automated evidence collection, and continuous monitoring."
>
  <Nav />

  <ProductHero
    eyebrow="Governance, Risk & Compliance"
    title="Automate compliance across every major framework"
    sub="Centralise governance, risk, and compliance in one platform — with real-time audit readiness, automated evidence collection, and continuous monitoring."
    primary={{ label: 'Book A Demo', href: '#demo' }}
    secondary={{ label: 'See Framework Coverage', href: '#coverage' }}
    chips={[
      { label: 'Frameworks supported', value: '10+' },
      { label: 'Evidence collection', value: 'Auto' },
      { label: 'Audit readiness', value: '100%' },
    ]}
    tagline="Evidence-driven. Always audit-ready."
  />

  <!-- ============ FRAMEWORK COVERAGE ============ -->
  <section id="coverage" class="section bg-white">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <span class="eyebrow">Framework Coverage</span>
        <h2 class="mt-4 h2">Every Framework.<br />One Control Set.</h2>
        <p class="sub mx-auto mt-5 max-w-[680px]">
          Map one control once and satisfy it everywhere. Aqua GRC keeps every framework in sync as your evidence
          changes.
        </p>
      </div>

      <div class="mt-[60px] grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]" data-reveal-group="60">
        {
          frameworks.map((f) => (
            <article class:list={[cardClass, 'gap-5 p-5']}>
              <img
                src={`/icons/${f.icon}.svg`}
                alt=""
                aria-hidden="true"
                width="60"
                height="60"
                class="mx-auto block h-[60px] w-[60px]"
              />
              <div class="flex flex-col gap-3 text-center">
                <h3 class="font-display text-h3 font-bold text-ink">{f.name}</h3>
                <p class="text-pretty text-small font-medium text-muted">{f.note}</p>
                <span class="eyebrow self-center">{f.controls}</span>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#demo" class="btn-outline whitespace-nowrap">Request A Custom Framework</a>
      </div>
    </div>
  </section>

  <!-- ============ KEY FEATURES ============ -->
  <section class="section section-tint">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <span class="eyebrow">Key Features</span>
        <h2 class="mt-4 h2">Governance, Risk And Compliance<br />In One Workspace.</h2>
      </div>

      <div class="mt-[60px] grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]" data-reveal-group="70">
        {
          features.map((f) => (
            <article class:list={[cardClass, 'gap-[18px] p-6']}>
              <img
                src={`/icons/${f.icon}.svg`}
                alt=""
                aria-hidden="true"
                width="52"
                height="52"
                class="block h-[52px] w-[52px]"
              />
              <div class="flex flex-col gap-2.5">
                <h3 class="font-display text-[22px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">{f.title}</h3>
                <p class="text-pretty text-small font-medium leading-[1.45] text-muted">{f.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section id="how" class="section bg-white">
    <div class="wrap">
      <div class="grid items-start gap-[60px] lg:grid-cols-[380px_minmax(0,1fr)]" data-reveal-group="110">
        <div>
          <span class="eyebrow">How It Works</span>
          <h2
            class="mt-4 font-display text-[clamp(30px,3.4vw,44px)] font-semibold leading-[1.115] tracking-[-0.02em] text-ink"
          >
            From Connected Systems To Audit Report
          </h2>
          <p class="sub mt-5 text-pretty">
            Aqua GRC runs continuously in the background. Connect once, and controls stay evidenced without a compliance
            sprint.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#demo" class="btn-primary">Schedule A Walkthrough</a>
          </div>
        </div>

        <div class="flex flex-col gap-5">
          {
            steps.map((s) => (
              <details
                open={s.open}
                class="acc rounded-xl border-[1.5px] border-line bg-white p-[22px] open:border-brand open:shadow-card-open"
              >
                <summary class="flex items-center justify-between gap-4">
                  <span class="flex items-center gap-4">
                    <span class="inline-flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-brand/[0.12] text-small font-bold text-brand">
                      {s.num}
                    </span>
                    <span class="font-display text-h3 font-semibold text-ink">{s.title}</span>
                  </span>
                  <svg
                    class="acc-chev shrink-0 transition-transform"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m6 9 6 6 6-6"
                      stroke="#0B1630"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <div class="acc-body">
                  <p class="ml-[50px] mt-3.5 text-pretty text-small font-medium leading-[1.5] text-muted">{s.body}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RISK REGISTER ============ -->
  <section id="platform" class="section section-tint">
    <div class="wrap">
      <div class="grid items-center gap-[60px] lg:grid-cols-[minmax(0,1fr)_550px]" data-reveal-group="110">
        <div class="card">
          <img
            src="/img/soc.png"
            alt="Risk register with owners, treatment plans and due dates"
            width="736"
            height="361"
            loading="lazy"
            class="block w-full rounded-lg"
          />
        </div>

        <div>
          <span class="eyebrow">Risk Register</span>
          <h2
            class="mt-4 font-display text-[clamp(30px,3.4vw,44px)] font-semibold leading-[1.115] tracking-[-0.02em] text-ink"
          >
            Track Every Risk From Identification To Acceptance
          </h2>
          <ul class="mt-6 flex flex-col gap-3.5">
            {
              riskPoints.map((p) => (
                <li class="flex items-start gap-3">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-0.5 shrink-0">
                    <circle cx="12" cy="12" r="10" fill="rgba(79,194,187,.14)" />
                    <path
                      d="m7.5 12.2 3 3 6-6.4"
                      stroke="#4FC2BB"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-[17px] font-medium leading-[1.45] text-muted">{p}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ USE CASES ============ -->
  <section class="section bg-white pb-0">
    <div class="wrap text-center" data-reveal>
      <span class="eyebrow">Use Cases</span>
      <h2 class="mt-4 h2">Who Uses Aqua GRC?</h2>

      <div class="mx-auto mt-8 flex max-w-[820px] flex-wrap justify-center gap-3">
        {
          useCases.map((u) => (
            <span class="rounded-full border border-brand/35 bg-brand/[0.08] px-5 py-2.5 text-small font-semibold text-ink">
              {u}
            </span>
          ))
        }
      </div>

      <p class="mx-auto mt-7 max-w-[720px] text-pretty text-[17px] font-medium leading-[1.5] text-muted">
        Aqua GRC is built for teams carrying audits alongside day-to-day security work — from a two-person compliance
        function to a 200-person enterprise programme.
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="demo" class="section bg-white">
    <div class="wrap">
      <div
        data-reveal
        class="flex flex-col items-center rounded-[20px] bg-[url('/background/background.svg')] bg-[length:100%_100%] bg-no-repeat px-6 py-16 text-center md:px-16 md:py-[80px]"
      >
        <span
          class="inline-block rounded-full border-[0.8px] border-white px-[14px] py-1 text-eyebrow font-bold uppercase tracking-[0.04em] text-white"
        >
          Get Started
        </span>
        <h2
          class="mt-4 font-display text-[clamp(28px,3.6vw,48px)] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          Be Audit-Ready Every Day Of The Year
        </h2>
        <p class="mx-auto mt-[18px] max-w-[720px] text-body font-medium text-white">
          Automated evidence collection, continuous control monitoring, and board-ready reporting in one platform.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="#demo" class="btn-light">Schedule A Demo</a>
          <a href="#contact" class="btn-ghost">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
