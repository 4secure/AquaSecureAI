---
import Base from '../../layouts/Base.astro';
import ProductDetail from '../../components/astro/pages/ProductDetail.astro';
import { PRODUCTS } from '../../data/products.js';

export function getStaticPaths() {
  return Object.entries(PRODUCTS).map(([slug, p]) => ({
    params: { slug },
    props: { name: p.name, description: p.sub || p.tagline || '', image: p.img || '/images/dashboard-hero.png' },
  }));
}

const { slug } = Astro.params;
const { name, description, image } = Astro.props;
---

<Base title={`${name} — Aqua Secure AI`} description={description} ogImage={image}>
  <ProductDetail slug={slug} />
</Base>
