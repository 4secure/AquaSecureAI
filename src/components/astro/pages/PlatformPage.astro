---
import { Icon } from 'astro-icon/components';

// Real platform architecture from aquasecure.ai
const PIPELINE = [
  {
    icon: 'lucide:shield',
    color: 'var(--accent)',
    stage: 'PREVENT',
    num: '01',
    title: 'Proactive Prevention',
    desc: 'GRC compliance automation, asset management, and workforce training form your first line of defence — eliminating vulnerabilities before attackers can exploit them.',
    items: [
      'GRC — CTDISR, ETGRM, ISO 27001',
      'Asset Management',
      'Training & Awareness programs',
    ],
  },
  {
    icon: 'lucide:activity',
    color: 'var(--accent-bright)',
    stage: 'DETECT',
    num: '02',
    title: 'AI-Powered Detection',
    desc: 'Global threat intelligence feeds, real-time IP reputation intelligence via AQUA TIP, and advanced correlation surface true threats from noise.',
    items: [
      'Threat Intelligence feeds',
      'AQUA TIP — Real-time IP lookup',
      'AI data enrichment & prioritisation',
      'Advanced threat correlation',
    ],
  },
  {
    icon: 'lucide:zap',
    color: '#29E07A',
    stage: 'RESPOND',
    num: '03',
    title: 'Automated Response',
    desc: 'The SOC platform empowers human analysts with AI-driven investigation, case management, automated incident creation, workflow orchestration, detection and response, and threat hunting — 24/7.',
    items: [
      'SOC analyst investigation tools',
      'Incident creation & workflow',
      'Detection and response automation',
      'Threat hunting capabilities',
    ],
  },
];

// Real Security Data Model from aquasecure.ai
const DATA_MODEL = [
  { label: 'TABULAR', desc: 'Structured security data in relational format' },
  { label: 'VECTOR', desc: 'ML-ready vector representations for AI models' },
  { label: 'DATA LAKE', desc: 'Unified raw event storage at scale' },
  { label: 'RAW', desc: 'Unprocessed incoming data from all sources' },
  { label: 'NORMALIZE', desc: 'Standardised data format for correlation' },
];
---

{/* ── PageHero ── */}
<section class="relative overflow-hidden pt-[108px] pb-12" style="background:var(--surface)">
  <div class="wrap relative z-10 text-center">
    <div>
      <div class="reveal flex justify-center mb-5">
        <span class="badge" style="background:rgba(var(--accent-rgb) / 0.12);color:var(--accent);border:1px solid rgba(var(--accent-rgb) / 0.25)">The Platform</span>
      </div>
      <h1 class="reveal delay-1 font-black text-text leading-[1.06] tracking-tight mb-4" style="font-size:clamp(34px,6vw,68px);letter-spacing:-0.03em;color:var(--text)">
        PREVENT · DETECT · RESPOND{' '}
      </h1>
      <p class="reveal delay-2 text-lead text-sub leading-[1.8] max-w-[580px] mx-auto mb-8" style="color:rgba(var(--text-rgb) / 0.65)">
        Modern SOC operations empowering human SOC analysts, real-time threat intelligence, and a unified security data model.
      </p>
      <a href="https://secureye.io/get-started" target="_blank" rel="noopener noreferrer" class="hero-cta btn-primary text-[15px] px-9 py-4 inline-block" style="background:linear-gradient(135deg, var(--accent), var(--accent-hover));color:white">
        Get Started Free
      </a>
    </div>
  </div>
</section>

<section class="section relative overflow-hidden" style="background:var(--bg)">
  {/* ParticleField count={30} color="109,86,165" */}
  <canvas data-particle-field data-count="30" data-color="109,86,165" class="absolute inset-0 w-full h-full pointer-events-none" style="opacity:.7"></canvas>

  {/* GlowOrbs variant="default" */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute rounded-full" style="width:700px;height:600px;top:-20%;left:40%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.16) 0%,transparent 70%);filter:blur(140px);animation:orbFloat 7s ease-in-out 0s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:400px;height:400px;bottom:-8%;left:-5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.12) 0%,transparent 70%);filter:blur(100px);animation:orbFloat 9s ease-in-out 1.5s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:300px;height:300px;top:25%;right:-8%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.09) 0%,transparent 70%);filter:blur(80px);animation:orbFloat 11s ease-in-out 3s infinite alternate"></div>
  </div>

  <div class="wrap relative z-10">
    {/* Pipeline header */}
    <div class="text-center mb-14">
      <p class="reveal badge mb-4">
        Full Pipeline
      </p>
      <h2 class="reveal delay-1 font-extrabold tracking-tight leading-tight mb-4" style="font-size:clamp(26px,3.8vw,44px);color:var(--text)">
        Three stages to complete{' '}
        <span style="background:linear-gradient(135deg,var(--text),var(--accent-light),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
          threat immunity
        </span>
      </h2>
    </div>

    {/* Pipeline flow chips */}
    <div class="flex flex-wrap items-center justify-center gap-3 mb-16">
      {
        PIPELINE.map((l, i) => (
          <div class="reveal flex items-center gap-3">
            <div
              class="pipeline-chip rounded-xl px-5 py-3 text-center border cursor-default transition-all"
              style={`background:var(--surface);border-color:rgba(var(--border-rgb) / 0.2);min-width:110px;--chip-color:${l.color}`}
            >
              <p class="text-[9px] uppercase tracking-widest mb-1" style="color:rgba(var(--text-rgb) / 0.4)">
                {l.num}
              </p>
              <p class="font-bold text-[14px]" style={`color:${l.color}`}>
                {l.stage}
              </p>
            </div>
            {i < PIPELINE.length - 1 && (
              <div class={`pipeline-arrow text-[20px] hidden sm:block ${i === 0 ? 'arrow-d0' : 'arrow-d1'}`} style="color:rgba(var(--accent-rgb) / 0.5)">
                →
              </div>
            )}
          </div>
        ))
      }
    </div>

    {/* Stage detail sections */}
    <div class="flex flex-col gap-12 mb-20">
      {
        PIPELINE.map((l, i) => {
          const isEven = i % 2 === 0;
          return (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center py-10 border-b last:border-0" style="border-color:rgba(var(--border-rgb) / 0.12)">
              <div class={`reveal ${!isEven ? 'lg:order-2' : ''}`}>
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-[10px] font-black px-3 py-1.5 rounded-pill" style={`background:${l.color}18;color:${l.color}`}>
                    {l.stage}
                  </span>
                  <span class="text-[11px] font-bold" style="color:rgba(var(--text-rgb) / 0.4)">
                    Stage {l.num}
                  </span>
                </div>
                <h3 class="font-extrabold mb-3 leading-tight" style="font-size:clamp(20px,2.5vw,30px);color:var(--text)">
                  {l.title}
                </h3>
                <p class="text-lead leading-[1.85] mb-5" style="color:rgba(var(--text-rgb) / 0.60)">
                  {l.desc}
                </p>
                <ul class="flex flex-col gap-2.5">
                  {
                    l.items.map((item) => (
                      <li class="flex items-center gap-2.5">
                        <span class="w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0" style={`background:${l.color}18`}>
                          <span style={`color:${l.color};font-size:9px`}>✓</span>
                        </span>
                        <span class="text-[13px]" style="color:rgba(var(--text-rgb) / 0.65)">
                          {item}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class={`reveal ${!isEven ? 'lg:order-1' : ''}`}>
                <div
                  class="stage-card rounded-xl p-8 relative overflow-hidden border"
                  style={`background:var(--surface);border-color:${l.color}30;--card-color:${l.color}`}
                >
                  <div class="absolute -top-14 -right-14 w-44 h-44 rounded-full blur-3xl pointer-events-none" style={`background:${l.color}0C`}></div>
                  <div class="stage-icon w-16 h-16 rounded-2xl flex items-center justify-center mb-5" style={`background:${l.color}18`}>
                    <Icon name={l.icon} class="w-8 h-8" style={`color:${l.color}`} stroke-width="1.6" />
                  </div>
                  <div class="flex items-center gap-2 mb-3">
                    <div class="w-2 h-2 rounded-full animate-pulse" style={`background:${l.color}`}></div>
                    <span class="text-[12px] font-bold" style={`color:${l.color}`}>
                      {l.stage} — Active
                    </span>
                  </div>
                  <p class="text-[13px] leading-relaxed" style="color:rgba(var(--text-rgb) / 0.55)">
                    {l.desc.slice(0, 100)}…
                  </p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* Security Data Model */}
    <div class="mb-16">
      <h2 class="reveal font-extrabold tracking-tight text-center mb-4" style="font-size:clamp(24px,3vw,38px);color:var(--text)">
        Security Data Model
      </h2>
      <p class="reveal delay-1 text-lead text-center mb-10 max-w-[480px] mx-auto" style="color:rgba(var(--text-rgb) / 0.55)">
        Unified incoming data from different sources — structured for AI, analytics, and real-time correlation.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {
          DATA_MODEL.map((d) => (
            <div class="data-card reveal rounded-xl p-5 text-center border transition-all cursor-default" style="background:var(--surface);border-color:rgba(var(--border-rgb) / 0.2)">
              <p class="text-[13px] font-black mb-2" style="color:var(--accent)">
                {d.label}
              </p>
              <p class="text-[11px] leading-snug" style="color:rgba(var(--text-rgb) / 0.50)">
                {d.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* AQUA TIP */}
    <div class="reveal rounded-xl p-10 md:p-14 text-center relative overflow-hidden border" style="background:linear-gradient(135deg,var(--surface),var(--surface-2),var(--surface));border-color:rgba(var(--accent-rgb) / 0.2)">
      {/* GlowOrbs variant="subtle" */}
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute rounded-full" style="width:600px;height:500px;top:-10%;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.10) 0%,transparent 70%);filter:blur(120px);animation:orbFloat 7s ease-in-out 0s infinite alternate"></div>
        <div class="absolute rounded-full" style="width:300px;height:300px;bottom:5%;right:5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.08) 0%,transparent 70%);filter:blur(80px);animation:orbFloat 9s ease-in-out 1.5s infinite alternate"></div>
      </div>
      <div class="relative z-10">
        <p class="reveal badge mb-4">STANDALONE PRODUCT</p>
        <h2 class="reveal delay-1 font-extrabold tracking-tight mb-3" style="font-size:clamp(24px,3vw,38px);color:var(--text)">
          AQUA TIP — Threat Intelligence Platform
        </h2>
        <p class="reveal delay-2 text-lead mb-7 max-w-[500px] mx-auto" style="color:rgba(var(--text-rgb) / 0.60)">
          Real-time IP reputation intelligence powered by global threat feeds. Real-Time IP Lookup · Threat Classification (malware, botnet, scanner, brute-force) · Risk Scoring. Start with 1 free search per day.
        </p>
        <div class="reveal delay-3 flex flex-wrap gap-4 justify-center">
          <a
            href="https://tip.aquasecure.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="tip-cta btn-primary text-[15px] px-9 py-4 inline-flex items-center gap-2"
          >
            Try AQUA TIP Free <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes orbFloat {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-18px) scale(1.04); }
  }

  /* PageHero CTA — whileHover scale 1.03 / shadow, whileTap scale .97 */
  .hero-cta { transition: transform .15s, box-shadow .15s; }
  .hero-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / 0.40); }
  .hero-cta:active { transform: scale(0.97); }

  /* Pipeline chip — whileHover y:-3, borderColor -> l.color */
  .pipeline-chip { transition: transform .2s, border-color .2s, box-shadow .2s; }
  .pipeline-chip:hover { transform: translateY(-3px); border-color: var(--chip-color); }

  /* Pipeline arrow — animate opacity [0.3,1,0.3], 2s loop, staggered delay i*0.4s */
  @keyframes arrowPulse {
    0% { opacity: 0.3; }
    50% { opacity: 1; }
    100% { opacity: 0.3; }
  }
  .pipeline-arrow { animation: arrowPulse 2s ease-in-out infinite; }
  .arrow-d0 { animation-delay: 0s; }
  .arrow-d1 { animation-delay: 0.4s; }

  /* Stage card — whileHover borderColor l.color55 + boxShadow */
  .stage-card { transition: border-color .2s, box-shadow .2s; }
  .stage-card:hover {
    border-color: color-mix(in srgb, var(--card-color) 33%, transparent);
    box-shadow: 0 0 40px color-mix(in srgb, var(--card-color) 7%, transparent);
  }

  /* Stage icon — whileHover rotate 10 scale 1.1 */
  .stage-icon { transition: transform .2s; }
  .stage-card:hover .stage-icon { transform: rotate(10deg) scale(1.1); }

  /* Data model card — whileHover y:-4, borderColor + boxShadow */
  .data-card { transition: transform .2s, border-color .2s, box-shadow .2s; }
  .data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--accent-rgb) / 0.45);
    box-shadow: 0 8px 24px rgba(var(--border-rgb) / 0.15);
  }

  /* TIP "Try AQUA TIP Free" — whileHover scale 1.03 / shadow, whileTap .97 */
  .tip-cta { transition: transform .15s, box-shadow .15s; }
  .tip-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .70); }
  .tip-cta:active { transform: scale(0.97); }
</style>

<script>
  function initPlatformPage() {
    const canvas = document.querySelector('canvas[data-particle-field]') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = '1';

    // Reimplement ParticleField: animated dot network on a canvas.
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const count = parseInt(canvas.dataset.count || '30', 10);
    const color = canvas.dataset.color || '109,86,165';
    let raf = 0;
    let W = 0;
    let H = 0;
    const particles: { x: number; y: number; vx: number; vy: number; r: number; o: number }[] = [];

    const resize = () => {
      W = canvas.width = canvas.offsetWidth;
      H = canvas.height = canvas.offsetHeight;
    };
    resize();
    window.addEventListener('resize', resize);

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        r: Math.random() * 1.8 + 0.6,
        o: Math.random() * 0.5 + 0.2,
      });
    }

    const draw = () => {
      ctx.clearRect(0, 0, W, H);

      // connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 130) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${color},${(1 - dist / 130) * 0.12})`;
            ctx.lineWidth = 0.7;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // dots
      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > W) p.vx *= -1;
        if (p.y < 0 || p.y > H) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color},${p.o})`;
        ctx.fill();
      });

      raf = requestAnimationFrame(draw);
    };
    draw();

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
    }, { once: true });
  }
  initPlatformPage();
  document.addEventListener('astro:page-load', initPlatformPage);
</script>
