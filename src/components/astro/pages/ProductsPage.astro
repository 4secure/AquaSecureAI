---
import { Icon } from 'astro-icon/components';

const PRODUCTS = [
  {
    icon: 'lucide:shield-check',
    slug: 'grc',
    name: 'GRC',
    tagline: 'Governance, Risk & Compliance',
    color: 'var(--accent-hover)',
    bg: 'rgba(var(--border-rgb) / 0.10)',
    bd: 'rgba(var(--border-rgb) / 0.25)',
    img: '/images/grc-dashboard.jpg',
    headline: 'Automate compliance across every major framework',
    desc: 'Automate compliance with ETHRM, CTDISR, ISO 27001, and more. Centralise governance, risk management, and compliance workflows with real-time audit readiness.',
    features: [
      'ISO 27001 framework',
      'Custom compliance frameworks',
      'Executive risk dashboards',
    ],
  },
  {
    icon: 'lucide:database',
    slug: 'siem',
    name: 'Aqua SIEM',
    tagline: 'Security Information & Event Management',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    bd: 'rgba(var(--accent-rgb) / 0.25)',
    img: '/images/Aqua-siem-dashboard.jpg',
    headline: 'Centralise and correlate security events in real time',
    desc: 'Aqua SIEM collects, correlates, and analyses security events across your entire infrastructure. Get real-time log management, threat detection rules, dashboards, and compliance reporting.',
    features: [
      'Real-time log collection & management',
      'Advanced event correlation rules',
      'Threat detection dashboards',
      'Compliance reporting',
      'Custom alerting & escalation',
      'SIEM-as-a-Service option',
    ],
  },
  {
    icon: 'lucide:activity',
    slug: 'soc',
    name: 'SOC',
    tagline: 'Security Operations Center',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    bd: 'rgba(var(--accent-rgb) / 0.25)',
    img: '/images/soc-dashboard.jpg',
    headline: 'AI-powered 24/7 threat detection and defense',
    desc: 'AI-powered monitoring and automated response for 24/7 threat detection. Empower human SOC analysts with AI SecOps — investigation, case management, incident workflows, and threat hunting.',
    features: [
      '24/7 AI-powered monitoring',
      'Automated incident creation',
      'SOC analyst investigation tools',
      'Case management workflows',
      'Detection and response automation',
      'Threat hunting capabilities',
    ],
  },

  {
    icon: 'lucide:box',
    slug: 'asset-management',
    name: 'Asset Management',
    tagline: 'Unified Asset Inventory',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    bd: 'rgba(var(--accent-rgb) / 0.25)',
    img: '/images/assets-dashboard.jpg',
    headline: 'Know exactly what you have and who owns it',
    desc: 'Unified asset inventory with real-time ownership and operational context. Full asset lifecycle management across cloud, on-prem, and hybrid environments with risk scoring.',
    features: [
      'Unified asset discovery',
      'Real-time ownership tracking',
      'Operational context mapping',
      'Cloud & on-prem coverage',
      'Asset risk scoring',
      'CMDB integration',
    ],
  },
  {
    icon: 'lucide:wifi',
    slug: 'dark-web',
    name: 'Dark Web',
    tagline: 'Dark Web Monitoring & Intelligence',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    bd: 'rgba(var(--accent-rgb) / 0.25)',
    img: '/images/darkweb-dashboard.jpg',
    headline: 'Monitor the dark web before attackers act',
    desc: 'Continuously scan dark web forums, marketplaces, and data breach repositories for mentions of your organisation, exposed credentials, and leaked assets.',
    features: [
      'Credential & data leak monitoring',
      'Brand & domain monitoring',
      'Dark web forum scanning',
      'Breach data detection',
      'Automated alert notifications',
      'Executive risk reporting',
    ],
  },
  // {
  //   icon: Bug, slug:'phishbot', name:'Phishbot', tagline:'Phishing Campaign Management',
  //   color:'var(--accent)', bg:'rgba(var(--accent-rgb) / 0.10)', bd:'rgba(var(--accent-rgb) / 0.25)',
  //   img:'/images/product-phishbot.jpg',
  //   headline:'Build a human firewall through realistic phishing tests',
  //   desc:'Launch automated phishing simulation campaigns to test employee awareness. Track click rates, identify at-risk staff, and deliver targeted training to strengthen your human firewall.',
  //   features:['Automated phishing campaigns','Realistic email templates','Click-through tracking','At-risk employee identification','Automated training assignment','Campaign performance dashboards'],
  // },
  {
    icon: 'lucide:globe',
    slug: 'threat-intel',
    name: 'Threat Intelligence',
    tagline: 'Global Cyber Threat Intel',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    bd: 'rgba(var(--accent-rgb) / 0.25)',
    img: '/images/tip-dashboard.jpeg',
    headline: 'Identify, analyze, and act on global cyber threats',
    desc: 'AI-powered intelligence feeds and predictive insights give you visibility into global threat actors, attack campaigns, and emerging TTPs before they reach your infrastructure.',
    features: [
      'AI-powered IOC feeds',
      'Predictive threat insights',
      'Global threat actor profiling',
      'Real-time intelligence correlation',
      'Dark web monitoring',
      'Threat classification by type',
    ],
  },
];
---

{/* ── PageHero ── */}
<section data-products-page class="relative overflow-hidden pt-14 pb-12" style="background:var(--surface)">
  <div class="wrap relative z-10 text-center">
    <div>
      <div class="reveal flex justify-center mb-5">
        <span class="badge" style="background:rgba(var(--accent-rgb) / 0.12);color:var(--accent);border:1px solid rgba(var(--accent-rgb) / 0.25)">Our Products</span>
      </div>
      <h1 class="reveal delay-1 font-black text-text leading-[1.06] tracking-tight mb-4" style="font-size:clamp(34px,6vw,68px);letter-spacing:-0.03em;color:var(--text)">
        Seven modules,{' '}
        <span class="tg" style="background:linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">one unified platform</span>
      </h1>
      <p class="reveal delay-2 text-lead text-sub leading-[1.8] max-w-[580px] mx-auto mb-8" style="color:rgba(var(--text-rgb) / 0.65)">
        Aqua SIEM · SOC · Threat Intelligence · Dark Web · Phishbot · Asset Management · GRC
      </p>
      <a href="https://secureye.io" target="_blank" rel="noopener noreferrer" class="hero-cta btn-primary text-[15px] px-9 py-4 inline-block" style="background:linear-gradient(135deg, var(--accent), var(--accent-hover));color:white">
        Get Started Free
      </a>
    </div>
  </div>
</section>

<div>
  {
    PRODUCTS.map((p, idx) => {
      const isEven = idx % 2 === 0;
      const isDark = idx % 2 !== 0;
      const bg = isDark ? 'var(--surface-2)' : 'var(--surface)';
      const textH = 'var(--text)';
      const textBody = 'rgba(var(--text-rgb) / 0.65)';
      const textFeat = 'rgba(var(--text-rgb) / 0.70)';
      const divider = 'rgba(var(--border-rgb) / 0.10)';
      return (
        <div style={`background:${bg}`}>
          <div class="relative mb-4 pt-6">
            <div class="product-badge w-12 h-12 rounded-xl flex items-center justify-center mx-auto shadow-sm" style={`background:${p.bg}`}>
              <Icon name={p.icon} class="w-6 h-6" style={`color:${p.color}`} />
            </div>
            <div class="text-center mt-2">
              <h3 class="text-2xl font-black mb-1" style={`color:${textH}`}>{p.name}</h3>
              <span class="inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded" style={`background:${p.color}10;color:${p.color}`}>
                {p.tagline}
              </span>
            </div>
          </div>
          <div class="wrap grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center py-2 pb-8 border-b last:border-0" style={`border-color:${divider}`}>
            {/* ── Text ── */}
            <div class={`reveal ${!isEven ? 'lg:order-2' : ''}`}>
              <h4 class="font-bold leading-tight mb-4" style={`font-size:clamp(18px,2.2vw,26px);color:${textH}`}>
                {p.headline}
              </h4>

              <p class="text-[14px] leading-[1.85] mb-6" style={`color:${textBody}`}>
                {p.desc}
              </p>

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-7">
                {p.features.map((f) => (
                  <li class="reveal flex items-center gap-2.5">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0" style={`background:${p.color}18`}>
                      <Icon name="lucide:check" class="w-3 h-3" style={`color:${p.color}`} />
                    </span>
                    <span class="text-[13px]" style={`color:${textFeat}`}>{f}</span>
                  </li>
                ))}
              </ul>

              <div class="flex gap-3">
                <a
                  href="https://secureye.io/get-started"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cta-get btn-primary text-[14px] inline-flex items-center gap-2"
                >
                  Get Started <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
                </a>
                <a href={`/products/${p.slug}`}>
                  <span class="cta-learn btn-outline text-[14px] inline-flex items-center gap-2 cursor-pointer" style="color:var(--text)">
                    Learn More <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
                  </span>
                </a>
              </div>
            </div>

            {/* ── Image ── */}
            <div class={`product-image reveal ${!isEven ? 'lg:order-1' : ''}`}>
              <div class="relative w-full">
                {/* Frame — no aspect ratio, natural image height */}
                <div class="relative rounded-2xl overflow-hidden border" style="border-color:rgba(var(--accent-rgb) / 0.35);box-shadow:0 4px 24px rgba(var(--accent-rgb) / 0.12);background:var(--bg)">
                  {/* Top bar chrome */}
                  <div class="flex items-center px-3 gap-1.5 h-8 flex-shrink-0" style="background:rgba(var(--bg-rgb) / 0.95);border-bottom:1px solid rgba(var(--accent-rgb) / 0.15)">
                    <div class="w-2.5 h-2.5 rounded-full" style="background:#FF5C5C"></div>
                    <div class="w-2.5 h-2.5 rounded-full" style="background:#FFB020"></div>
                    <div class="w-2.5 h-2.5 rounded-full" style="background:#29E07A"></div>
                    <div class="flex-1 mx-3 h-4 rounded-md" style="background:rgba(255,255,255,0.06)"></div>
                  </div>

                  {/* Screenshot — natural size, no crop, no zoom */}
                  <img
                    src={p.img}
                    alt={`${p.name} dashboard`}
                    class="product-shot w-full h-auto block"
                    style="background:var(--bg)"
                  />

                  {/* Placeholder — hidden by default */}
                  <div class="product-placeholder flex-col items-center justify-center gap-3 py-16" style="display:none;background:var(--bg)">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center border" style="background:rgba(var(--accent-rgb) / 0.08);border-color:rgba(var(--accent-rgb) / 0.20)">
                      <svg class="w-7 h-7 opacity-30" fill="none" stroke="rgba(var(--accent-rgb) / 0.8)" stroke-width="1.5" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="M21 15l-5-5L5 21" />
                      </svg>
                    </div>
                    <p class="text-[12px] font-semibold" style="color:rgba(var(--accent-rgb) / 0.60)">{p.name} screenshot</p>
                    <p class="text-[10px] text-center px-6" style="color:rgba(255,255,255,0.20)">public{p.img}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

{/* TIP callout */}
<section class="section-sm relative overflow-hidden" style="background:var(--surface-2)">
  {/* GlowOrbs variant="subtle" */}
  <div class="glow-orbs absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute rounded-full" style="width:600px;height:500px;top:-10%;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.10) 0%,transparent 70%);filter:blur(120px);animation:orbFloat 7s ease-in-out 0s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:300px;height:300px;bottom:5%;right:5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.08) 0%,transparent 70%);filter:blur(80px);animation:orbFloat 9s ease-in-out 1.5s infinite alternate"></div>
  </div>
  <div class="wrap relative z-10">
    <div class="reveal rounded-xl p-10 md:p-14 text-center relative overflow-hidden border" style="background:linear-gradient(135deg,var(--surface),var(--surface-2),var(--surface));border-color:rgba(var(--accent-rgb) / 0.22)">
      {/* GlowOrbs variant="subtle" */}
      <div class="glow-orbs absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute rounded-full" style="width:600px;height:500px;top:-10%;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.10) 0%,transparent 70%);filter:blur(120px);animation:orbFloat 7s ease-in-out 0s infinite alternate"></div>
        <div class="absolute rounded-full" style="width:300px;height:300px;bottom:5%;right:5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.08) 0%,transparent 70%);filter:blur(80px);animation:orbFloat 9s ease-in-out 1.5s infinite alternate"></div>
      </div>
      <div class="relative z-10">
        <p class="reveal badge mb-4">STANDALONE PRODUCT</p>
        <h2 class="reveal delay-1 font-extrabold tracking-tight mb-4" style="font-size:clamp(24px,3vw,40px);color:var(--text)">
          AQUA TIP — Threat Intelligence Platform
        </h2>
        <p class="reveal delay-2 text-lead mb-3 max-w-[540px] mx-auto" style="color:rgba(var(--text-rgb) / 0.60)">
          Know Your Threats Before They Strike. Real-time IP reputation intelligence powered by global threat feeds.
        </p>
        <p class="reveal delay-3 text-[14px] mb-7" style="color:rgba(var(--text-rgb) / 0.45)">
          Real-Time IP Lookup · Threat Classification · Risk Scoring · 1 free search/day
        </p>
        <div class="reveal delay-4 flex flex-wrap gap-4 justify-center">
          <a
            href="https://tip.aquasecure.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="tip-cta btn-primary text-[15px] px-9 py-4 inline-flex items-center gap-2"
          >
            Try AQUA TIP Free <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
          <a href="/contact">
            <span class="tip-outline btn-outline text-[15px] px-9 py-4 inline-flex items-center gap-2 cursor-pointer">
              Contact Sales
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes orbFloat {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-18px) scale(1.04); }
  }

  /* PageHero CTA — whileHover scale 1.03 / shadow, whileTap scale .97 */
  .hero-cta { transition: transform .15s, box-shadow .15s; }
  .hero-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / 0.40); }
  .hero-cta:active { transform: scale(0.97); }

  /* Product icon badge — whileHover y:-3 */
  .product-badge { transition: transform .2s; }
  .product-badge:hover { transform: translateY(-3px); }

  /* Product image column — whileHover y:-5 spring */
  .product-image { transition: transform .3s cubic-bezier(0.16,1,0.3,1); }
  .product-image:hover { transform: translateY(-5px); }

  /* Section "Get Started" — whileHover scale 1.04 / shadow, whileTap .97 */
  .cta-get { transition: transform .15s, box-shadow .15s; }
  .cta-get:hover { transform: scale(1.04); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .70); }
  .cta-get:active { transform: scale(0.97); }

  /* Section "Learn More" — whileHover borderColor + x:2 */
  .cta-learn { transition: transform .15s, border-color .15s; }
  .cta-learn:hover { border-color: rgba(var(--accent-rgb) / 0.55); transform: translateX(2px); }

  /* TIP "Try AQUA TIP Free" — whileHover scale 1.03 / shadow, whileTap .97 */
  .tip-cta { transition: transform .15s, box-shadow .15s; }
  .tip-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .70); }
  .tip-cta:active { transform: scale(0.97); }

  /* TIP "Contact Sales" — whileHover borderColor */
  .tip-outline { transition: border-color .15s; }
  .tip-outline:hover { border-color: rgba(var(--accent-rgb) / 0.6); }
</style>

<script>
  function initProductsPage() {
    const root = document.querySelector('[data-products-page]') || document.body;
    if (root.dataset.productsBound) return;
    root.dataset.productsBound = '1';

    // Reimplement <img onError> fallback: hide broken screenshot, reveal placeholder.
    document.querySelectorAll('img.product-shot').forEach((img) => {
      const el = img as HTMLImageElement;
      const showPlaceholder = () => {
        el.style.display = 'none';
        const ph = el.nextElementSibling as HTMLElement | null;
        if (ph) ph.style.display = 'flex';
      };
      if (el.complete && el.naturalWidth === 0) {
        showPlaceholder();
      } else {
        el.addEventListener('error', showPlaceholder);
      }
    });
  }
  initProductsPage();
  document.addEventListener('astro:page-load', initProductsPage);
</script>
