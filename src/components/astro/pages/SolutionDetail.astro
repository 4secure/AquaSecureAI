---
import { Icon } from 'astro-icon/components';
import { SOLUTIONS } from '../../../data/solutions.js';

const { slug } = Astro.props;
const s = SOLUTIONS[slug];

const others = Object.entries(SOLUTIONS).filter(([k]) => k !== slug);
---

{/* ── Hero: text left, image right ── */}
<section class="relative overflow-hidden pt-[108px] pb-20" style="background:var(--surface)">
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.15]"
    style="background-image:radial-gradient(circle, rgba(var(--accent-rgb) / 0.25) 1px, transparent 1px);background-size:28px 28px"
  ></div>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse 60% 60% at 50% 40%, rgba(var(--accent-rgb) / 0.05) 0%, transparent 70%)"
  ></div>

  <div class="wrap relative z-10">
    <div
      class="reveal flex items-center gap-2 mb-8 text-[12px] font-medium"
      style="color:rgba(var(--text-rgb) / 0.55)"
    >
      <a href="/" class="crumb-link transition-colors">Home</a>
      <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />
      <a href="/solutions" class="crumb-link transition-colors">Solutions</a>
      <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />
      <span style="color:var(--accent)">{s.name}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="reveal delay-1 flex items-center gap-3 mb-6">
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center"
            style={`background:${s.bg};border:1px solid ${s.color}25`}
          >
            <Icon name={s.icon} class="w-7 h-7" style={`color:${s.color}`} />
          </div>
          <div>
            <p
              class="text-[11px] font-bold uppercase tracking-widest"
              style={`color:${s.color}`}
            >
              {s.tagline}
            </p>
            <h1 class="text-[26px] font-extrabold" style="color:var(--text)">
              {s.name}
            </h1>
          </div>
        </div>

        <h2
          class="reveal delay-2 font-extrabold leading-tight mb-5"
          style="font-size:clamp(28px,3.8vw,46px);color:var(--text);letter-spacing:-0.02em"
        >
          {s.headline}
        </h2>

        <p
          class="reveal delay-3 text-[16px] leading-[1.8] mb-8"
          style="color:rgba(var(--text-rgb) / 0.65);max-width:520px"
        >
          {s.sub}
        </p>

        <div class="reveal delay-4 flex gap-8 mb-8">
          {
            s.stats.map((st) => (
              <div>
                <div class="text-[22px] font-extrabold" style={`color:${s.color}`}>
                  {st.val}
                </div>
                <div class="text-[11px] font-medium" style="color:rgba(var(--text-rgb) / 0.55)">
                  {st.label}
                </div>
              </div>
            ))
          }
        </div>

        <div class="reveal delay-5 flex gap-3">
          <a
            href="https://secureye.io"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-primary btn-primary text-[14px] inline-flex items-center gap-2"
          >
            Get Started Free <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
          </a>
          <a href="/contact">
            <span
              class="cta-outline btn-outline text-[14px] inline-flex items-center gap-2 cursor-pointer"
              style="color:var(--text)"
            >
              Talk to Us <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
            </span>
          </a>
        </div>
      </div>

      <div class="reveal">
        <div class="sol-image">
          <div
            class="relative rounded-2xl overflow-hidden border"
            style="border-color:rgba(var(--accent-rgb) / 0.20);box-shadow:0 8px 40px rgba(var(--accent-rgb) / 0.10)"
          >
            <div
              class="flex items-center gap-1.5 px-3 h-8 flex-shrink-0"
              style="background:var(--surface-2);border-bottom:1px solid rgba(var(--accent-rgb) / 0.12)"
            >
              <div class="w-2.5 h-2.5 rounded-full" style="background:#FF5C5C"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background:#FFB020"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background:#29E07A"></div>
              <div class="flex-1 mx-3 h-4 rounded" style="background:rgba(var(--accent-rgb) / 0.08)"></div>
            </div>
            <img
              src={s.img}
              alt={`${s.name} screenshot`}
              class="sol-img w-full h-auto block"
              style="background:var(--surface-2)"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ── Features ── */}
<section class="section" style="background:var(--surface-2)">
  <div class="wrap">
    <div class="text-center mb-14">
      <p
        class="reveal delay-1 inline-block text-[11px] font-bold uppercase tracking-widest mb-4 px-3 py-1 rounded-full"
        style={`background:${s.color}12;color:${s.color};border:1px solid ${s.color}25`}
      >
        How It Works
      </p>
      <h2
        class="reveal delay-2 font-extrabold tracking-tight mb-3"
        style="font-size:clamp(24px,3vw,38px);color:var(--text)"
      >
        What's included in {s.name}
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        s.features.map((f) => (
          <div
            class="feature-card reveal rounded-2xl p-6 border bg-white"
            style="border-color:rgba(var(--accent-rgb) / 0.12);box-shadow:0 2px 12px rgba(var(--accent-rgb) / 0.05)"
          >
            <div
              class="w-9 h-9 rounded-xl flex items-center justify-center mb-4"
              style={`background:${s.bg}`}
            >
              <Icon name="lucide:check" class="w-4 h-4" style={`color:${s.color}`} />
            </div>
            <h3 class="text-[15px] font-extrabold mb-2" style="color:var(--text)">
              {f.title}
            </h3>
            <p class="text-[13px] leading-relaxed" style="color:rgba(var(--text-rgb) / 0.60)">
              {f.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

{/* ── Who is this for: text left, CTA right ── */}
<section class="section-sm" style="background:var(--surface)">
  <div class="wrap">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p
          class="text-[11px] font-bold uppercase tracking-widest mb-4"
          style={`color:${s.color}`}
        >
          Who Is This For
        </p>
        <h2
          class="font-extrabold mb-6"
          style="font-size:clamp(22px,2.8vw,34px);color:var(--text)"
        >
          Built for teams like yours
        </h2>
        <div class="flex flex-col gap-3 mb-6">
          {
            s.whoFor.map((w) => (
              <div class="flex items-start gap-3">
                <div
                  class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
                  style={`background:${s.color}15`}
                >
                  <Icon name="lucide:check" class="w-3 h-3" style={`color:${s.color}`} />
                </div>
                <span class="text-[14px]" style="color:rgba(var(--text-rgb) / 0.70)">
                  {w}
                </span>
              </div>
            ))
          }
        </div>
        <div class="flex flex-col gap-2">
          {
            s.benefits.map((b) => (
              <div class="flex items-center gap-2.5">
                <div
                  class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                  style={`background:${s.color}`}
                ></div>
                <span class="text-[13px] font-medium" style="color:rgba(var(--text-rgb) / 0.65)">
                  {b}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="reveal rounded-2xl p-8 border"
        style={`background:linear-gradient(135deg, ${s.bg}, rgba(255,255,255,0.8));border-color:${s.color}22;box-shadow:0 4px 28px ${s.color}0e`}
      >
        <h3 class="text-[20px] font-extrabold mb-2" style="color:var(--text)">
          Get started with {s.name}
        </h3>
        <p class="text-[13px] mb-6" style="color:rgba(var(--text-rgb) / 0.60)">
          Access the full platform on secureye.io or talk to our team for
          a tailored walkthrough.
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="https://secureye.io"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-primary btn-primary text-[14px] inline-flex items-center justify-center gap-2"
          >
            Get Started Free <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
          </a>
          <a href="/contact">
            <span
              class="cta-outline btn-outline text-[14px] w-full inline-flex items-center justify-center gap-2 cursor-pointer"
              style="color:var(--text)"
            >
              Request a Demo
            </span>
          </a>
        </div>
        <p class="text-[11px] mt-4 text-center" style="color:rgba(var(--text-rgb) / 0.40)">
          info@aquasecure.ai · aquasecure.ai
        </p>
      </div>
    </div>
  </div>
</section>

{/* ── Other Solutions ── */}
<section class="section-sm" style="background:var(--surface-2)">
  <div class="wrap">
    <p
      class="reveal text-center text-[13px] font-semibold mb-6"
      style="color:rgba(var(--text-rgb) / 0.55)"
    >
      Explore all solutions
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {
        others.map(([k, sol]) => (
          <a href={`/solutions/${k}`}>
            <div
              class="sol-chip reveal flex items-center gap-2.5 px-4 py-2.5 rounded-xl border bg-white"
              style="border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 8px rgba(var(--accent-rgb) / 0.05)"
            >
              <div
                class="w-7 h-7 rounded-lg flex items-center justify-center"
                style={`background:${sol.bg}`}
              >
                <Icon name={sol.icon} class="w-3.5 h-3.5" style={`color:${sol.color}`} />
              </div>
              <span class="text-[13px] font-semibold" style="color:var(--text)">
                {sol.name}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* breadcrumb link hover (React: hover:text-[var(--accent)]) */
  .crumb-link:hover { color: var(--accent); }

  /* CTA primary hover/tap (framer whileHover scale + shadow, whileTap scale) */
  .cta-primary { transition: transform .15s, box-shadow .15s; }
  .cta-primary:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .55); }
  .cta-primary:active { transform: scale(0.97); }

  /* CTA outline hover (framer whileHover border-color) */
  .cta-outline { transition: border-color .15s; }
  .cta-outline:hover { border-color: rgba(var(--accent-rgb) / 0.5); }

  /* Hero image lift (framer whileHover y:-4, spring) */
  .sol-image { transition: transform .3s cubic-bezier(.16,1,.3,1); }
  .sol-image:hover { transform: translateY(-4px); }

  /* Feature card hover (framer whileHover y:-3 + shadow + border) */
  .feature-card { transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s cubic-bezier(.16,1,.3,1), border-color .25s cubic-bezier(.16,1,.3,1); }
  .feature-card:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(var(--accent-rgb) / 0.07); border-color: rgba(var(--accent-rgb) / 0.16); }

  /* Related solution chip hover (framer whileHover y:-2 + border + shadow) */
  .sol-chip { transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s cubic-bezier(.16,1,.3,1), border-color .2s cubic-bezier(.16,1,.3,1); }
  .sol-chip:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb) / 0.35); box-shadow: 0 6px 20px rgba(var(--accent-rgb) / 0.10); }
</style>

<script>
  function initSolutionDetail() {
    const imgs = document.querySelectorAll<HTMLImageElement>('img.sol-img');
    imgs.forEach((img) => {
      if (img.dataset.bound) return;
      img.dataset.bound = '1';
      // React onError: hide broken screenshots
      img.addEventListener('error', () => {
        img.style.display = 'none';
      });
    });
  }
  initSolutionDetail();
  document.addEventListener('astro:page-load', initSolutionDetail);
</script>
