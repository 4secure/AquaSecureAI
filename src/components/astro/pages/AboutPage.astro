---
import { Icon } from 'astro-icon/components';

// Real data from aquasecure.ai footer and content
const PRODUCTS_LIST = [
  "GRC (Governance, Risk & Compliance)",
  "SOC (Security Operations Center)",
  "Threat Intelligence",
  "Asset Management",
  "Training & Awareness",
];

const FRAMEWORKS = [
  "CTDISR",
  "ISO 27001",
  "ETGRM",
];

const STATS = [
  ["7+", "Security Modules"],
  ["24/7", "SOC Monitoring"],
  ["6+", "GRC Frameworks"],
  ["Free", "TIP Searches/Day"],
];
---

{/* ── PageHero (badge / title / accent / sub, no cta) ── */}
<section class="relative overflow-hidden pt-14 pb-12" style="background:var(--surface)">
  <div class="wrap relative z-10 text-center">
    <div>
      <div class="reveal flex justify-center mb-5">
        <span class="badge" style="background:rgba(var(--accent-rgb) / 0.12);color:var(--accent);border:1px solid rgba(var(--accent-rgb) / 0.25)">About Aqua Secure AI</span>
      </div>
      <h1 class="reveal delay-1 font-black text-text leading-[1.06] tracking-tight mb-4" style="font-size:clamp(34px,6vw,68px);letter-spacing:-0.03em;color:var(--text)">
        Modern SOC Operations{' '}
        <span class="tg" style="background:linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Empowering Human</span>
      </h1>
      <p class="reveal delay-2 text-lead text-sub leading-[1.8] max-w-[580px] mx-auto mb-8" style="color:rgba(var(--text-rgb) / 0.65)">
        Cybersecurity is crucial in today's digital world — Aqua Secure AI ensures your assets remain protected from evolving global threats.
      </p>
    </div>
  </div>
</section>

<section class="section relative overflow-hidden" style="background:var(--bg)">
  {/* GlowOrbs variant="default" */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute rounded-full" style="width:700px;height:600px;top:-20%;left:40%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.16) 0%,transparent 70%);filter:blur(140px);animation:float 7s ease-in-out 0s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:400px;height:400px;bottom:-8%;left:-5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.12) 0%,transparent 70%);filter:blur(100px);animation:float 9s ease-in-out 1.5s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:300px;height:300px;top:25%;right:-8%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.09) 0%,transparent 70%);filter:blur(80px);animation:float 11s ease-in-out 3s infinite alternate"></div>
  </div>
  <div class="wrap relative z-10">
    {/* Mission */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center mb-24">
      <div>
        <p class="reveal badge mb-5">Our Mission</p>
        <h2 class="reveal delay-1 font-extrabold tracking-tight leading-tight mb-5" style="font-size:clamp(26px,3.5vw,42px);color:var(--text)">
          Protecting the digital world,{' '}
          <span style="background:linear-gradient(135deg,var(--text),var(--accent-light),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
            one organisation at a time
          </span>
        </h2>
        <p class="reveal delay-2 text-lead leading-[1.85] mb-5" style="color:rgba(var(--text-rgb) / 0.60)">
          Cybersecurity is crucial in today's digital world — Aqua Secure
          AI ensures your assets remain protected from evolving global
          threats. We combine AI-powered SOC operations, GRC compliance
          automation, real-time threat intelligence, and workforce
          training into one unified platform.
        </p>
        <p class="reveal delay-3 text-lead leading-[1.85] mb-7" style="color:rgba(var(--text-rgb) / 0.60)">
          Our platform — accessible via{' '}
          <a
            href="https://secureye.io"
            target="_blank"
            rel="noopener noreferrer"
            style="color:var(--accent)"
            class="hover:underline"
          >
            secureye.io
          </a>{' '}
          — empowers human SOC analysts with AI-driven investigation, case
          management, detection and response, and threat hunting. Our
          standalone Threat Intelligence Platform at{' '}
          <a
            href="https://tip.aquasecure.ai"
            target="_blank"
            rel="noopener noreferrer"
            style="color:var(--accent)"
            class="hover:underline"
          >
            tip.aquasecure.ai
          </a>{' '}
          delivers real-time IP reputation intelligence for free.
        </p>
        <div class="reveal delay-4 flex flex-wrap gap-3">
          <a
            href="https://secureye.io/get-started"
            target="_blank"
            rel="noopener noreferrer"
            class="mission-cta btn-primary inline-flex items-center gap-2"
          >
            Get Started <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
          <a
            href="mailto:info@aquasecure.ai"
            class="mission-outline btn-outline inline-flex items-center gap-2"
          >
            Contact Us
          </a>
        </div>
      </div>

      <div class="reveal-right grid grid-cols-2 gap-4">
        {
          STATS.map(([v, l]) => (
            <div
              class="stat-card rounded-xl p-6 text-center border transition-all"
              style="background:var(--surface);border-color:rgba(var(--border-rgb) / 0.2)"
            >
              <p
                class="text-[34px] font-black mb-1"
                style="background:linear-gradient(135deg,var(--text),var(--accent-light),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"
              >
                {v}
              </p>
              <p class="text-[13px]" style="color:rgba(var(--text-rgb) / 0.55)">
                {l}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Products */}
    <div class="mb-24">
      <h2 class="reveal font-extrabold tracking-tight text-center mb-10" style="font-size:clamp(24px,3vw,38px);color:var(--text)">
        Our Product Suite
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          PRODUCTS_LIST.map((p) => (
            <div
              class="reveal product-card rounded-xl p-5 border transition-all cursor-default"
              style="background:var(--surface);border-color:rgba(var(--border-rgb) / 0.2)"
            >
              <div
                class="w-8 h-8 rounded-lg mb-3 flex items-center justify-center"
                style="background:linear-gradient(135deg,rgba(var(--accent-rgb) / 0.2),rgba(var(--border-rgb) / 0.1))"
              >
                <Icon name="lucide:shield" class="w-4 h-4" style="color:var(--accent)" />
              </div>
              <p class="text-[14px] font-semibold" style="color:var(--text)">
                {p}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Compliance frameworks */}
    <div class="mb-24">
      <h2 class="reveal font-extrabold tracking-tight text-center mb-10" style="font-size:clamp(24px,3vw,38px);color:var(--text)">
        Compliance Framework Coverage
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          FRAMEWORKS.map((f) => (
            <div
              class="reveal framework-card rounded-xl p-5 text-center border transition-all cursor-default"
              style="background:var(--surface);border-color:rgba(var(--border-rgb) / 0.2)"
            >
              <div
                class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center"
                style="background:linear-gradient(135deg,var(--accent),var(--accent-hover))"
              >
                <span class="text-white font-black text-[10px]">
                  {f.slice(0, 3)}
                </span>
              </div>
              <p class="text-[13px] font-bold" style="color:var(--text)">
                {f}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Contact CTA */}
    <div
      class="reveal rounded-xl p-10 md:p-14 text-center relative overflow-hidden border"
      style="background:linear-gradient(135deg,var(--surface),var(--surface-2),var(--surface));border-color:rgba(var(--accent-rgb) / 0.2)"
    >
      {/* GlowOrbs variant="subtle" */}
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute rounded-full" style="width:600px;height:500px;top:-10%;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.10) 0%,transparent 70%);filter:blur(120px);animation:float 7s ease-in-out 0s infinite alternate"></div>
        <div class="absolute rounded-full" style="width:300px;height:300px;bottom:5%;right:5%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.08) 0%,transparent 70%);filter:blur(80px);animation:float 9s ease-in-out 1.5s infinite alternate"></div>
      </div>
      <div class="relative z-10">
        <h2 class="reveal font-extrabold tracking-tight mb-4" style="font-size:clamp(24px,3vw,38px);color:var(--text)">
          Get in Touch
        </h2>
        <p class="reveal delay-1 text-lead mb-3 max-w-[440px] mx-auto" style="color:rgba(var(--text-rgb) / 0.60)">
          Ready to protect your organisation? Contact us today.
        </p>
        <p class="reveal delay-2 text-[15px] font-semibold mb-7" style="color:var(--accent)">
          info@aquasecure.ai
        </p>
        <div class="reveal delay-3 flex flex-wrap gap-4 justify-center">
          <a
            href="https://secureye.io/get-started"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-primary btn-primary text-[15px] px-9 py-4 inline-flex items-center gap-2"
          >
            Get Started Free <Icon name="lucide:external-link" class="w-4 h-4" />
          </a>
          <a
            href="mailto:info@aquasecure.ai"
            class="cta-outline btn-outline text-[15px] px-9 py-4 inline-flex items-center gap-2"
          >
            Send us an Email
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-18px) scale(1.04); }
  }

  /* fadeRight scroll reveal (stats column) */
  .reveal-right {
    opacity: 0;
    transform: translateX(36px);
    transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);
  }
  .reveal-right.in { opacity: 1; transform: translateX(0); }

  /* Mission "Get Started" — whileHover scale 1.03 / shadow, whileTap .97 */
  .mission-cta { transition: transform .15s, box-shadow .15s; }
  .mission-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .70); }
  .mission-cta:active { transform: scale(0.97); }

  /* Mission "Contact Us" — whileHover borderColor */
  .mission-outline { transition: border-color .15s; }
  .mission-outline:hover { border-color: rgba(var(--accent-rgb) / 0.6); }

  /* Stat card — whileHover y:-4 / borderColor */
  .stat-card:hover { transform: translateY(-4px); border-color: rgba(var(--accent-rgb) / 0.4); }

  /* Product card — whileHover y:-4 / borderColor */
  .product-card:hover { transform: translateY(-4px); border-color: rgba(var(--accent-rgb) / 0.4); }

  /* Framework card — whileHover y:-4 / borderColor / shadow */
  .framework-card:hover { transform: translateY(-4px); border-color: rgba(var(--accent-rgb) / 0.5); box-shadow: 0 8px 24px rgba(var(--border-rgb) / 0.15); }

  /* Contact CTA "Get Started Free" — whileHover scale 1.03 / shadow, whileTap .97 */
  .cta-primary { transition: transform .15s, box-shadow .15s; }
  .cta-primary:hover { transform: scale(1.03); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / .70); }
  .cta-primary:active { transform: scale(0.97); }

  /* Contact CTA "Send us an Email" — whileHover borderColor */
  .cta-outline { transition: border-color .15s; }
  .cta-outline:hover { border-color: rgba(var(--accent-rgb) / 0.6); }
</style>

<script>
  function initAboutPage() {
    const els = document.querySelectorAll('.reveal-right:not(.in)');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.1, rootMargin: '0px 0px -32px 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
  initAboutPage();
  document.addEventListener('astro:page-load', initAboutPage);
</script>
