---
import { Icon } from 'astro-icon/components';

const TOPICS = ['General Enquiry', 'Product Demo', 'Pricing & Plans', 'Technical Support', 'Partnership / Reseller', 'Other'];

const PRODUCTS_LIST = ['Aqua SIEM', 'SOC', 'Threat Intelligence', 'Dark Web', 'Phishbot', 'Asset Management', 'GRC'];
const SOLUTIONS_LIST = ['Manage SIEM', 'Attack Surface', 'DMARC', 'Fishing Campaigns', 'E-learning', 'Compliance Management'];

const PRODUCT_SLUGS = {
  'Aqua SIEM': 'siem', 'SOC': 'soc', 'Threat Intelligence': 'threat-intel',
  'Dark Web': 'dark-web', 'Phishbot': 'phishbot', 'Asset Management': 'asset-management', 'GRC': 'grc',
};
const SOLUTION_SLUGS = {
  'Manage SIEM': 'manage-siem', 'Attack Surface': 'attack-surface', 'DMARC': 'dmarc',
  'Fishing Campaigns': 'fishing-campaigns', 'E-learning': 'e-learning', 'Compliance Management': 'compliance-management',
};

const INFO_CARDS = [
  {
    icon: 'lucide:mail',
    color: 'var(--accent)',
    bg: 'rgba(var(--accent-rgb) / 0.10)',
    label: 'Email Us',
    value: 'info@aquasecure.ai',
    sub: 'We reply within 24 hours',
    href: 'mailto:info@aquasecure.ai',
  },
  {
    icon: 'lucide:message-square',
    color: '#29E07A',
    bg: 'rgba(41,224,122,0.10)',
    label: 'Live Chat',
    value: 'Start a conversation',
    sub: 'Available Mon–Fri, 9am–6pm SGT',
    href: '#',
  },
];
---

{/* ── Hero ── */}
<section
  class="relative overflow-hidden pt-14 pb-20"
  style="background:var(--surface)"
>
  <div class="absolute inset-0 bg-grid pointer-events-none opacity-50"></div>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse 65% 55% at 50% 40%, rgba(var(--accent-rgb) / 0.13) 0%, transparent 70%)"
  >
  </div>
  {/* GlowOrbs variant="hero" */}
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute rounded-full" style="width:900px;height:700px;top:-25%;left:35%;transform:translateX(-50%);background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.20) 0%,transparent 70%);filter:blur(160px);animation:cpFloat 7s ease-in-out 0s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:500px;height:500px;bottom:0;left:-10%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.13) 0%,transparent 70%);filter:blur(120px);animation:cpFloat 9s ease-in-out 1.5s infinite alternate"></div>
    <div class="absolute rounded-full" style="width:350px;height:350px;top:30%;right:-6%;background:radial-gradient(circle,rgba(var(--accent-rgb) / 0.08) 0%,transparent 70%);filter:blur(90px);animation:cpFloat 11s ease-in-out 3s infinite alternate"></div>
  </div>

  <div class="wrap relative z-10 text-center">
    <div>
      <div class="reveal flex justify-center mb-5">
        <span class="badge">Get In Touch</span>
      </div>
      <h1
        class="reveal delay-1 font-black leading-tight tracking-tight mb-5"
        style="font-size:clamp(38px,5.5vw,66px);color:var(--text);letter-spacing:-0.03em"
      >
        Let's Talk{' '}
        <span class="tg">Security</span>
      </h1>
      <p
        class="reveal delay-2 text-lead leading-[1.8] max-w-[500px] mx-auto"
        style="color:rgba(var(--text-rgb) / 0.6)"
      >
        Have questions, need a demo, or want to discuss your organisation's
        security needs? We'd love to hear from you.
      </p>
    </div>
  </div>
</section>

{/* ── Main content ── */}
<section class="relative overflow-hidden" style="background:var(--surface-2)">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse 80% 50% at 50% 80%, rgba(var(--border-rgb) / 0.10) 0%, transparent 70%)"
  >
  </div>

  <div class="wrap pb-24 relative z-10 mt-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-10 lg:gap-14">
      {/* ── Left: Form ── */}
      <div class="reveal-left" data-contact-page>
        <div
          class="rounded-2xl p-8 lg:p-10 border"
          style="background:rgba(var(--surface-rgb) / 0.85);border-color:rgba(var(--border-rgb) / 0.18);box-shadow:0 4px 40px rgba(var(--border-rgb) / 0.10);backdrop-filter:blur(12px)"
        >
          {/* Success view */}
          <div class="cp-success" hidden>
            <div
              class="flex flex-col items-center justify-center text-center py-16 gap-5"
            >
              <div
                class="cp-success-ring w-20 h-20 rounded-full flex items-center justify-center"
                style="background:rgba(41,224,122,0.10);border:1px solid rgba(41,224,122,0.30)"
              >
                <Icon name="lucide:check-circle" class="w-10 h-10" style="color:#29E07A" />
              </div>
              <div>
                <h3
                  class="text-[24px] font-extrabold mb-2"
                  style="color:var(--text)"
                >
                  Message Sent!
                </h3>
                <p
                  class="text-[14px] max-w-[300px] mx-auto"
                  style="color:rgba(var(--text-rgb) / 0.60)"
                >
                  Thanks for reaching out. Our team will get back to you
                  within 24 hours.
                </p>
              </div>
              <button
                class="cp-reset mt-2 text-[13px] font-semibold px-6 py-2.5 rounded-xl border transition-all"
                style="background:rgba(var(--accent-rgb) / 0.08);color:var(--accent-hover);border-color:rgba(var(--accent-rgb) / 0.20)"
              >
                Send another message
              </button>
            </div>
          </div>

          {/* Form view */}
          <div class="cp-form-wrap">
            <div class="mb-8">
              <h2
                class="text-[22px] font-extrabold mb-1.5"
                style="color:var(--text)"
              >
                Send us a message
              </h2>
              <p
                class="text-[13px]"
                style="color:rgba(var(--text-rgb) / 0.45)"
              >
                Fill out the form and we'll get back to you within 24
                hours.
              </p>
            </div>

            <form class="cp-form flex flex-col gap-5" novalidate>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {/* Full Name */}
                <div class="flex flex-col gap-1.5">
                  <label class="text-[12px] font-semibold" style="color:rgba(var(--text-rgb) / 0.65)">
                    Full Name<span style="color:var(--accent)"> *</span>
                  </label>
                  <input
                    name="name"
                    type="text"
                    placeholder="John Smith"
                    required
                    class="cp-input rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 w-full"
                    style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:var(--text)"
                  />
                </div>
                {/* Email Address */}
                <div class="flex flex-col gap-1.5">
                  <label class="text-[12px] font-semibold" style="color:rgba(var(--text-rgb) / 0.65)">
                    Email Address<span style="color:var(--accent)"> *</span>
                  </label>
                  <input
                    name="email"
                    type="email"
                    placeholder="john@company.com"
                    required
                    class="cp-input rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 w-full"
                    style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:var(--text)"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {/* Company */}
                <div class="flex flex-col gap-1.5">
                  <label class="text-[12px] font-semibold" style="color:rgba(var(--text-rgb) / 0.65)">
                    Company
                  </label>
                  <input
                    name="company"
                    type="text"
                    placeholder="Your company name"
                    class="cp-input rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 w-full"
                    style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:var(--text)"
                  />
                </div>
                {/* ── Topic Dropdown ── */}
                <div class="cp-select flex flex-col gap-1.5 relative" data-name="topic">
                  <label class="text-[12px] font-semibold" style="color:rgba(var(--text-rgb) / 0.65)">
                    Topic
                  </label>
                  <button
                    type="button"
                    class="cp-select-trigger rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 w-full text-left flex items-center justify-between gap-3"
                    style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:var(--text)"
                  >
                    <span class="cp-select-label truncate">General Enquiry</span>
                    <Icon
                      name="lucide:chevron-down"
                      class="cp-select-chevron w-4 h-4 flex-shrink-0 transition-transform duration-200"
                      style="color:rgba(var(--text-rgb) / 0.55)"
                    />
                  </button>
                  <ul
                    class="cp-select-menu absolute left-0 right-0 z-50 rounded-xl py-2 max-h-56 overflow-y-auto"
                    style="top:100%;margin-top:4px;background:rgba(var(--surface-rgb) / 0.98);border:1px solid rgba(var(--accent-rgb) / 0.20);box-shadow:0 12px 40px rgba(var(--border-rgb) / 0.18), 0 4px 12px rgba(var(--border-rgb) / 0.10);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)"
                    hidden
                  >
                    {TOPICS.map((opt) => (
                      <li
                        class="cp-select-option px-4 py-2.5 text-[14px] cursor-pointer transition-all duration-150 flex items-center gap-2.5"
                        data-value={opt}
                        style="color:var(--text);background:transparent;font-weight:400"
                      >
                        <span class="cp-select-check w-4 h-4 flex items-center justify-center flex-shrink-0">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </span>
                        <span class="truncate">{opt}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* ── Products / Solutions picker ── */}
              <div class="flex flex-col gap-3">
                <label
                  class="text-[12px] font-semibold"
                  style="color:rgba(var(--text-rgb) / 0.65)"
                >
                  Interested in a Product or Solution?{' '}
                  <span
                    style="color:rgba(var(--text-rgb) / 0.35);font-weight:400"
                  >
                    (optional)
                  </span>
                </label>

                {/* Toggle buttons */}
                <div class="flex gap-3">
                  {['Products', 'Solutions'].map((cat) => (
                    <button
                      type="button"
                      class="cp-cat-toggle flex items-center gap-2 px-4 py-2.5 rounded-xl text-[13px] font-semibold border transition-all duration-200"
                      data-cat={cat}
                      style="background:rgba(var(--surface-rgb) / 0.90);border-color:rgba(var(--border-rgb) / 0.22);color:rgba(var(--text-rgb) / 0.60)"
                    >
                      <span
                        class="cp-cat-radio"
                        style="width:14px;height:14px;border-radius:50%;border:2px solid;border-color:rgba(var(--border-rgb) / 0.35);background:transparent;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0"
                      >
                        <span
                          class="cp-cat-radio-dot"
                          style="width:5px;height:5px;border-radius:50%;background:var(--surface);display:none"
                        ></span>
                      </span>
                      {cat}
                    </button>
                  ))}
                </div>

                {/* ── Second Dropdown (Products/Solutions) ── */}
                <div class="cp-item-wrap flex flex-col gap-3" hidden>
                  {/* Products/Solutions themed select */}
                  <div class="cp-select flex flex-col gap-1.5 relative" data-name="item">
                    <button
                      type="button"
                      class="cp-select-trigger rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 w-full text-left flex items-center justify-between gap-3"
                      style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:rgba(var(--text-rgb) / 0.40)"
                    >
                      <span class="cp-select-label truncate cp-item-placeholder">Select...</span>
                      <Icon
                        name="lucide:chevron-down"
                        class="cp-select-chevron w-4 h-4 flex-shrink-0 transition-transform duration-200"
                        style="color:rgba(var(--text-rgb) / 0.55)"
                      />
                    </button>
                    <ul
                      class="cp-select-menu cp-item-menu absolute left-0 right-0 z-50 rounded-xl py-2 max-h-56 overflow-y-auto"
                      style="top:100%;margin-top:4px;background:rgba(var(--surface-rgb) / 0.98);border:1px solid rgba(var(--accent-rgb) / 0.20);box-shadow:0 12px 40px rgba(var(--border-rgb) / 0.18), 0 4px 12px rgba(var(--border-rgb) / 0.10);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)"
                      hidden
                    >
                    </ul>
                  </div>

                  {/* Route link — appears when item is selected */}
                  <div class="cp-item-link" hidden>
                    <a
                      class="cp-item-anchor inline-flex items-center gap-1.5 text-[12px] font-semibold px-3 py-1.5 rounded-lg transition-all"
                      target="_blank"
                      href="#"
                      style="color:var(--accent);background:rgba(var(--accent-rgb) / 0.08);border:1px solid rgba(var(--accent-rgb) / 0.20)"
                    >
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                      View <span class="cp-item-link-name"></span> page
                    </a>
                  </div>
                </div>
              </div>

              {/* Message */}
              <div class="flex flex-col gap-1.5">
                <label class="text-[12px] font-semibold" style="color:rgba(var(--text-rgb) / 0.65)">
                  Message<span style="color:var(--accent)"> *</span>
                </label>
                <textarea
                  name="message"
                  placeholder="Tell us about your security needs, what you're looking for, or any questions you have..."
                  required
                  rows="6"
                  class="cp-input rounded-xl px-4 py-3 text-[14px] outline-none transition-all duration-200 resize-none w-full"
                  style="background:rgba(var(--surface-rgb) / 0.90);border:1px solid rgba(var(--border-rgb) / 0.22);color:var(--text)"
                ></textarea>
              </div>

              <button
                type="submit"
                class="cp-submit flex items-center justify-center gap-2.5 w-full px-8 py-4 rounded-xl font-semibold text-[15px] text-white mt-1"
                style="background:linear-gradient(135deg,var(--accent),var(--accent-hover));box-shadow:0 4px 20px rgba(var(--accent-rgb) / 0.38)"
              >
                <span class="cp-submit-idle flex items-center gap-2.5">
                  <Icon name="lucide:send" class="w-4 h-4" /> Send Message
                </span>
                <span class="cp-submit-busy hidden items-center gap-2.5">
                  <div class="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin"></div>{' '}
                  Sending...
                </span>
              </button>
            </form>
          </div>
        </div>
      </div>

      {/* ── Right: Info ── */}
      <div
        class="reveal-right flex flex-col gap-4 lg:sticky lg:top-28"
      >
        {/* Info cards */}
        {INFO_CARDS.map((card, i) => (
          <div
            class="cp-info-card flex items-center gap-4 rounded-2xl p-5 border transition-all duration-300 group"
            style="background:rgba(var(--surface-rgb) / 0.80);border-color:rgba(var(--border-rgb) / 0.18);backdrop-filter:blur(12px)"
            data-color={card.color}
          >
            <div
              class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
              style={`background:${card.bg}`}
            >
              <Icon
                name={card.icon}
                class="w-5 h-5"
                style={`color:${card.color};stroke-width:1.8`}
              />
            </div>
            <div class="flex-1 min-w-0">
              <p
                class="text-[10px] font-bold uppercase tracking-wider mb-0.5"
                style="color:rgba(var(--text-rgb) / 0.45)"
              >
                {card.label}
              </p>
              {card.href ? (
                <a
                  href={card.href}
                  target={card.href.startsWith('mailto') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                  class="cp-info-value text-[14px] font-semibold block truncate transition-colors duration-200"
                  style="color:var(--text)"
                  data-color={card.color}
                >
                  {card.value}
                </a>
              ) : (
                <p
                  class="text-[14px] font-semibold"
                  style="color:var(--text)"
                >
                  {card.value}
                </p>
              )}
              <p
                class="text-[11px] mt-0.5"
                style="color:rgba(var(--text-rgb) / 0.45)"
              >
                {card.sub}
              </p>
            </div>
          </div>
        ))}

        {/* TIP CTA card */}
        <div
          class="reveal delay-4 rounded-2xl p-6 border mt-2"
          style="background:linear-gradient(135deg, rgba(var(--accent-rgb) / 0.08), rgba(var(--border-rgb) / 0.04));border-color:rgba(var(--accent-rgb) / 0.22)"
        >
          <div class="flex items-center gap-2 mb-3">
            <div
              class="w-8 h-8 rounded-lg flex items-center justify-center"
              style="background:rgba(var(--accent-rgb) / 0.12)"
            >
              <Icon name="lucide:shield" class="w-4 h-4" style="color:var(--accent)" />
            </div>
            <h3
              class="text-[15px] font-extrabold"
              style="color:var(--text)"
            >
              Try before you commit
            </h3>
          </div>
          <p
            class="text-[13px] leading-relaxed mb-4"
            style="color:rgba(var(--text-rgb) / 0.60)"
          >
            Get 1 free IP lookup per day on our Threat Intelligence
            Platform — no credit card needed.
          </p>
          <a
            href="https://tip.aquasecure.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="cp-tip-cta inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-[13px] font-semibold text-white"
            style="background:linear-gradient(135deg,var(--accent),var(--accent-hover));box-shadow:0 4px 14px rgba(var(--accent-rgb) / 0.30)"
          >
            Try AQUA TIP Free <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes cpFloat {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-18px) scale(1.04); }
  }

  /* framer whileInView fadeLeft on the form column */
  .reveal-left {
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);
  }
  .reveal-left.in { opacity: 1; transform: translateX(0); }

  /* framer whileInView fadeRight on the info column */
  .reveal-right {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);
  }
  .reveal-right.in { opacity: 1; transform: translateX(0); }

  /* Input focus — replicate onFocus border + ring */
  .cp-input:focus {
    border-color: rgba(var(--accent-rgb) / 0.55) !important;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb) / 0.08);
  }

  /* Select trigger focus/open styling handled in JS via .cp-open, mirror focus ring */
  .cp-select-trigger:focus,
  .cp-select.cp-open .cp-select-trigger {
    border-color: rgba(var(--accent-rgb) / 0.55) !important;
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb) / 0.08);
  }
  .cp-select.cp-open .cp-select-chevron { transform: rotate(180deg); }

  /* Dropdown option hover — whileHover background */
  .cp-select-option:hover { background: rgba(var(--accent-rgb) / 0.06) !important; }

  /* Success ring pop-in — framer spring scale 0 -> 1 */
  .cp-success:not([hidden]) .cp-success-ring {
    animation: cpRingPop .4s cubic-bezier(.34,1.56,.64,1) .1s both;
  }
  @keyframes cpRingPop {
    0% { transform: scale(0); }
    100% { transform: scale(1); }
  }

  /* Success container fade/scale in */
  .cp-success:not([hidden]) > div {
    animation: cpFade .3s ease both;
  }
  @keyframes cpFade {
    0% { opacity: 0; transform: scale(0.96); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* "Send another message" — whileHover background */
  .cp-reset:hover { background: rgba(var(--accent-rgb) / 0.20) !important; }

  /* Submit button — whileHover scale 1.02 / shadow, whileTap scale .97 */
  .cp-submit { transition: transform .15s, box-shadow .15s; }
  .cp-submit:not(:disabled):hover { transform: scale(1.02); box-shadow: 0 6px 30px rgba(var(--accent-rgb) / 0.55); }
  .cp-submit:not(:disabled):active { transform: scale(0.97); }
  .cp-submit:disabled { opacity: 0.9; cursor: not-allowed; }

  /* TIP CTA — whileHover scale 1.04 / shadow, whileTap .97 */
  .cp-tip-cta { transition: transform .15s, box-shadow .15s; }
  .cp-tip-cta:hover { transform: scale(1.04); box-shadow: 0 6px 22px rgba(var(--accent-rgb) / 0.50); }
  .cp-tip-cta:active { transform: scale(0.97); }
</style>

<script
  define:vars={{
    PRODUCTS_LIST,
    SOLUTIONS_LIST,
    PRODUCT_SLUGS,
    SOLUTION_SLUGS,
  }}
>
  function initContactPage() {
    const root = document.querySelector('[data-contact-page]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const card = root.querySelector('.rounded-2xl');
    const form = card.querySelector('.cp-form');
    const successView = card.querySelector('.cp-success');
    const formWrap = card.querySelector('.cp-form-wrap');
    const submitBtn = card.querySelector('.cp-submit');
    const idle = card.querySelector('.cp-submit-idle');
    const busy = card.querySelector('.cp-submit-busy');
    const resetBtn = card.querySelector('.cp-reset');

    // ── form state ──
    const state = {
      name: '',
      email: '',
      company: '',
      topic: 'General Enquiry',
      category: '',
      item: '',
      message: '',
    };

    // ── Inputs (name/email/company/message) ──
    card.querySelectorAll('.cp-input').forEach((el) => {
      el.addEventListener('input', () => {
        state[el.name] = el.value;
      });
    });

    // ── Themed Select helper ──
    function setupSelect(selectEl, onChange, getOptions) {
      const trigger = selectEl.querySelector('.cp-select-trigger');
      const menu = selectEl.querySelector('.cp-select-menu');
      const labelEl = selectEl.querySelector('.cp-select-label');
      const name = selectEl.dataset.name;

      const closeMenu = () => {
        menu.hidden = true;
        selectEl.classList.remove('cp-open');
      };
      const openMenu = () => {
        menu.hidden = false;
        selectEl.classList.add('cp-open');
      };

      trigger.addEventListener('click', () => {
        if (menu.hidden) openMenu();
        else closeMenu();
      });

      // Delegate option clicks
      menu.addEventListener('click', (e) => {
        const li = e.target.closest('.cp-select-option');
        if (!li) return;
        const value = li.dataset.value;
        state[name] = value;
        onChange && onChange(value);
        renderSelected(value);
        closeMenu();
      });

      const renderSelected = (value) => {
        const options = getOptions ? getOptions() : Array.from(menu.querySelectorAll('.cp-select-option')).map((o) => o.dataset.value);
        const isSelected = Boolean(value);
        labelEl.textContent = isSelected ? value : (selectEl.dataset.placeholder || 'Select...');
        trigger.style.color = isSelected ? 'var(--text)' : 'rgba(var(--border-rgb) / 0.40)';
        menu.querySelectorAll('.cp-select-option').forEach((li) => {
          const sel = li.dataset.value === value;
          li.style.color = sel ? 'var(--accent)' : 'var(--text)';
          li.style.background = sel ? 'rgba(var(--accent-rgb) / 0.08)' : 'transparent';
          li.style.fontWeight = sel ? '600' : '400';
          const check = li.querySelector('.cp-select-check svg');
          if (check) check.style.display = sel ? 'block' : 'none';
        });
      };

      // Outside click closes
      document.addEventListener('mousedown', (e) => {
        if (!selectEl.contains(e.target)) closeMenu();
      });

      return { renderSelected, closeMenu };
    }

    // Topic select (pre-selected General Enquiry)
    const topicSelect = card.querySelector('.cp-select[data-name="topic"]');
    const topicCtl = setupSelect(topicSelect, (v) => { state.topic = v; });
    topicCtl.renderSelected('General Enquiry');

    // ── Category toggles (Products / Solutions) ──
    const itemWrap = card.querySelector('.cp-item-wrap');
    const itemSelect = card.querySelector('.cp-select[data-name="item"]');
    const itemMenu = card.querySelector('.cp-item-menu');
    const itemPlaceholder = card.querySelector('.cp-item-placeholder');
    const itemLinkWrap = card.querySelector('.cp-item-link');
    const itemAnchor = card.querySelector('.cp-item-anchor');
    const itemLinkName = card.querySelector('.cp-item-link-name');

    let itemCtl = null;

    const buildItemMenu = (category) => {
      const list = category === 'Products' ? PRODUCTS_LIST : SOLUTIONS_LIST;
      itemMenu.innerHTML = '';
      list.forEach((opt) => {
        const li = document.createElement('li');
        li.className = 'cp-select-option px-4 py-2.5 text-[14px] cursor-pointer transition-all duration-150 flex items-center gap-2.5';
        li.dataset.value = opt;
        li.style.color = 'var(--text)';
        li.style.background = 'transparent';
        li.style.fontWeight = '400';
        li.innerHTML =
          '<span class="cp-select-check w-4 h-4 flex items-center justify-center flex-shrink-0">' +
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"></polyline></svg>' +
          '</span><span class="truncate">' + opt + '</span>';
        itemMenu.appendChild(li);
      });
    };

    const refreshItemLink = () => {
      if (state.item) {
        const slug = state.category === 'Products'
          ? PRODUCT_SLUGS[state.item]
          : SOLUTION_SLUGS[state.item];
        const base = state.category === 'Products' ? '/products/' : '/solutions/';
        itemAnchor.href = base + slug;
        itemLinkName.textContent = state.item;
        itemLinkWrap.hidden = false;
      } else {
        itemLinkWrap.hidden = true;
      }
    };

    // set up item select once (menu is rebuilt on category change)
    itemCtl = setupSelect(itemSelect, (v) => {
      state.item = v;
      refreshItemLink();
    });

    card.querySelectorAll('.cp-cat-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        // toggle behavior — clicking active clears it
        state.category = state.category === cat ? '' : cat;
        state.item = '';

        // update toggle visuals
        card.querySelectorAll('.cp-cat-toggle').forEach((b) => {
          const active = state.category === b.dataset.cat;
          b.style.background = active ? 'rgba(var(--accent-rgb) / 0.10)' : 'rgba(255,255,255,0.90)';
          b.style.borderColor = active ? 'rgba(var(--accent-rgb) / 0.50)' : 'rgba(var(--border-rgb) / 0.22)';
          b.style.color = active ? 'var(--accent)' : 'rgba(var(--border-rgb) / 0.60)';
          const radio = b.querySelector('.cp-cat-radio');
          const dot = b.querySelector('.cp-cat-radio-dot');
          radio.style.borderColor = active ? 'var(--accent)' : 'rgba(var(--border-rgb) / 0.35)';
          radio.style.background = active ? 'var(--accent)' : 'transparent';
          dot.style.display = active ? 'block' : 'none';
        });

        if (state.category) {
          itemWrap.hidden = false;
          buildItemMenu(state.category);
          itemPlaceholder.textContent = '— Select a ' + state.category.slice(0, -1) + ' —';
          itemSelect.dataset.placeholder = '— Select a ' + state.category.slice(0, -1) + ' —';
          itemCtl.renderSelected('');
        } else {
          itemWrap.hidden = true;
        }
        refreshItemLink();
      });
    });

    // ── Submit ──
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!state.name || !state.email || !state.message) return;

      submitBtn.disabled = true;
      idle.classList.add('hidden');
      busy.classList.remove('hidden');
      busy.classList.add('flex');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            access_key: '02610ac4-e0df-4304-b478-e41a9d58e328',
            subject: '[Aqua Secure] ' + state.topic +
              (state.category ? ' — ' + state.category + ': ' + state.item : '') +
              ' — from ' + state.name,
            from_name: 'Aqua Secure Website',
            name: state.name,
            email: state.email,
            company: state.company,
            topic: state.topic,
            category: state.category || 'None',
            item: state.item || 'None',
            message: state.message,
          }),
        });

        const data = await res.json();

        if (data.success) {
          formWrap.hidden = true;
          successView.hidden = false;
        } else {
          alert(data.message || 'Something went wrong');
        }
      } catch (error) {
        alert('Network error. Try again.');
      } finally {
        submitBtn.disabled = false;
        idle.classList.remove('hidden');
        busy.classList.add('hidden');
        busy.classList.remove('flex');
      }
    });

    // ── Reset (Send another message) ──
    resetBtn.addEventListener('click', () => {
      successView.hidden = true;
      formWrap.hidden = false;

      // reset state
      state.name = '';
      state.email = '';
      state.company = '';
      state.topic = 'General Enquiry';
      state.category = '';
      state.item = '';
      state.message = '';

      // reset fields
      form.reset();
      card.querySelectorAll('.cp-input').forEach((el) => { el.value = ''; });
      topicCtl.renderSelected('General Enquiry');

      // reset category toggles
      card.querySelectorAll('.cp-cat-toggle').forEach((b) => {
        b.style.background = 'rgba(var(--surface-rgb) / 0.90)';
        b.style.borderColor = 'rgba(var(--border-rgb) / 0.22)';
        b.style.color = 'rgba(var(--text-rgb) / 0.60)';
        const radio = b.querySelector('.cp-cat-radio');
        const dot = b.querySelector('.cp-cat-radio-dot');
        radio.style.borderColor = 'rgba(var(--border-rgb) / 0.35)';
        radio.style.background = 'transparent';
        dot.style.display = 'none';
      });
      itemWrap.hidden = true;
      itemLinkWrap.hidden = true;
    });

    // ── Info card hover (borderColor + background) ──
    card.ownerDocument.querySelectorAll('.cp-info-card').forEach((el) => {
      const color = el.dataset.color;
      el.addEventListener('mouseenter', () => {
        el.style.borderColor = color + '40';
        el.style.background = 'rgba(var(--surface-rgb) / 0.98)';
      });
      el.addEventListener('mouseleave', () => {
        el.style.borderColor = 'rgba(var(--border-rgb) / 0.18)';
        el.style.background = 'rgba(var(--surface-rgb) / 0.80)';
      });
    });

    // ── Info value link hover (color swap) ──
    document.querySelectorAll('.cp-info-value').forEach((el) => {
      const color = el.dataset.color;
      el.addEventListener('mouseenter', () => { el.style.color = color; });
      el.addEventListener('mouseleave', () => { el.style.color = 'var(--text)'; });
    });

    // ── Reveal for the two column wrappers (fadeLeft / fadeRight) ──
    const cols = document.querySelectorAll('.reveal-left:not(.in), .reveal-right:not(.in)');
    if (!('IntersectionObserver' in window)) {
      cols.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.1, rootMargin: '0px 0px -32px 0px' }
      );
      cols.forEach((el) => io.observe(el));
    }
  }

  initContactPage();
  document.addEventListener('astro:page-load', initContactPage);
</script>
