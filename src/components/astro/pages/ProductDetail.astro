---
import { Icon } from 'astro-icon/components';
import { PRODUCTS } from '../../../data/products.js';

const { slug } = Astro.props;
const p = PRODUCTS[slug];

const others = Object.entries(PRODUCTS).filter(([s]) => s !== slug);
---

{/* ── Hero ── */}
<section
  class="relative overflow-hidden pt-[108px] pb-20"
  style="background:var(--surface)"
>
  {/* Dot grid */}
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.15]"
    style="background-image:radial-gradient(circle, rgba(var(--accent-rgb) / 0.25) 1px, transparent 1px);background-size:28px 28px"
  >
  </div>
  {/* Radial tint */}
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:radial-gradient(ellipse 60% 60% at 50% 40%, rgba(var(--accent-rgb) / 0.06) 0%, transparent 70%)"
  >
  </div>

  <div class="wrap relative z-10">
    {/* Breadcrumb */}
    <div
      class="reveal flex items-center gap-2 mb-8 text-[12px] font-medium"
      style="color:rgba(var(--text-rgb) / 0.55)"
    >
      <a href="/" class="hover:text-[var(--accent)] transition-colors">Home</a>
      <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />
      <a href="/products" class="hover:text-[var(--accent)] transition-colors">
        Products
      </a>
      <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />
      <span style="color:var(--accent)">{p.name}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      {/* Left */}
      <div>
        <div class="reveal delay-1 flex items-center gap-3 mb-6">
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center"
            style={`background:${p.bg};border:1px solid ${p.color}25`}
          >
            <Icon
              name={p.icon}
              class="w-7 h-7"
              style={`color:${p.color}`}
              stroke-width={1.6}
            />
          </div>
          <div>
            <p
              class="text-[11px] font-bold uppercase tracking-widest"
              style={`color:${p.color}`}
            >
              {p.tagline}
            </p>
            <h1
              class="text-[26px] font-extrabold"
              style="color:var(--text)"
            >
              {p.name}
            </h1>
          </div>
        </div>

        <h2
          class="reveal delay-2 font-extrabold leading-tight mb-5"
          style="font-size:clamp(28px,3.8vw,46px);color:var(--text);letter-spacing:-0.02em"
        >
          {p.headline}
        </h2>

        <p
          class="reveal delay-2 text-[16px] leading-[1.8] mb-8"
          style="color:rgba(var(--text-rgb) / 0.65);max-width:520px"
        >
          {p.sub}
        </p>

        {/* Stats */}
        <div class="reveal delay-3 flex gap-8 mb-8">
          {
            p.stats.map((s) => (
              <div>
                <div
                  class="text-[22px] font-extrabold"
                  style={`color:${p.color}`}
                >
                  {s.val}
                </div>
                <div
                  class="text-[11px] font-medium"
                  style="color:rgba(var(--text-rgb) / 0.55)"
                >
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>

        <div class="reveal delay-3 flex gap-3">
          <a
            href="https://secureye.io"
            target="_blank"
            rel="noopener noreferrer"
            class="pd-cta-primary btn-primary text-[14px] inline-flex items-center gap-2"
          >
            Get Started Free <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
          </a>
          {/* <a
            href="mailto:info@aquasecure.ai"
            class="btn-outline text-[14px] inline-flex items-center gap-2"
            style="color:var(--text)"
          >
            Request Demo <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
          </a> */}
        </div>
      </div>

      {/* Right — Dashboard image */}
      <div class="reveal pd-hero-img">
        <div
          class="relative rounded-2xl overflow-hidden border"
          style="border-color:rgba(var(--accent-rgb) / 0.20);box-shadow:0 8px 40px rgba(var(--accent-rgb) / 0.10)"
        >
          {/* Chrome bar */}
          <div
            class="flex items-center gap-1.5 px-3 h-8 flex-shrink-0"
            style="background:var(--surface-2);border-bottom:1px solid rgba(var(--accent-rgb) / 0.12)"
          >
            <div
              class="w-2.5 h-2.5 rounded-full"
              style="background:#FF5C5C"
            >
            </div>
            <div
              class="w-2.5 h-2.5 rounded-full"
              style="background:#FFB020"
            >
            </div>
            <div
              class="w-2.5 h-2.5 rounded-full"
              style="background:#29E07A"
            >
            </div>
            <div
              class="flex-1 mx-3 h-4 rounded"
              style="background:rgba(var(--accent-rgb) / 0.08)"
            >
            </div>
          </div>
          <img
            src={p.img}
            alt={`${p.name} dashboard`}
            class="w-full h-auto block"
            style="background:var(--surface-2)"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
    </div>
  </div>
</section>

{/* ── Features ── */}
<section class="section" style="background:var(--surface-2)">
  <div class="wrap">
    <div class="text-center mb-14">
      <p
        class="reveal delay-1 inline-block text-[11px] font-bold uppercase tracking-widest mb-4 px-3 py-1 rounded-full"
        style={`background:${p.color}12;color:${p.color};border:1px solid ${p.color}25`}
      >
        Key Features
      </p>
      <h2
        class="reveal delay-2 font-extrabold tracking-tight mb-3"
        style="font-size:clamp(24px,3vw,38px);color:var(--text)"
      >
        Everything you need in one platform
      </h2>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
    >
      {
        p.features.map((f) => (
          <div
            class="pd-feature reveal rounded-2xl p-6 border bg-white transition-all duration-300 group"
            style="border-color:rgba(var(--accent-rgb) / 0.12);box-shadow:0 2px 12px rgba(var(--accent-rgb) / 0.05)"
          >
            <div
              class="w-9 h-9 rounded-xl flex items-center justify-center mb-4"
              style={`background:${p.bg}`}
            >
              <Icon
                name="lucide:check"
                class="w-4 h-4"
                style={`color:${p.color}`}
                stroke-width={2.5}
              />
            </div>
            <h3
              class="text-[15px] font-extrabold mb-2"
              style="color:var(--text)"
            >
              {f.title}
            </h3>
            <p
              class="text-[13px] leading-relaxed"
              style="color:rgba(var(--text-rgb) / 0.60)"
            >
              {f.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

{/* ── Use Cases + CTA ── */}
<section class="section-sm" style="background:var(--surface)">
  <div class="wrap">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <p
          class="text-[11px] font-bold uppercase tracking-widest mb-4"
          style={`color:${p.color}`}
        >
          Use Cases
        </p>
        <h2
          class="font-extrabold mb-6"
          style="font-size:clamp(22px,2.8vw,34px);color:var(--text)"
        >
          Who uses {p.name}?
        </h2>
        <div class="flex flex-wrap gap-3 mb-8">
          {
            p.useCases.map((u) => (
              <span
                class="px-4 py-2 rounded-full text-[13px] font-semibold border"
                style={`background:${p.bg};color:${p.color};border-color:${p.color}25`}
              >
                {u}
              </span>
            ))
          }
        </div>
        <p
          class="text-[14px] leading-relaxed mb-6"
          style="color:rgba(var(--text-rgb) / 0.60)"
        >
          {p.name} is built for security teams who need real results — not
          just dashboards. Whether you're a 2-person team or a 200-person
          enterprise SOC, it scales to your needs.
        </p>
        <a href="/contact">
          <span
            class="pd-talk inline-flex items-center gap-2 text-[14px] font-semibold"
            style={`color:${p.color}`}
          >
            Talk to our team <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </span>
        </a>
      </div>

      <div
        class="reveal rounded-2xl p-8 border"
        style={`background:linear-gradient(135deg, ${p.bg}, rgba(255,255,255,0.8));border-color:${p.color}20;box-shadow:0 4px 28px ${p.color}0e`}
      >
        <h3
          class="text-[20px] font-extrabold mb-2"
          style="color:var(--text)"
        >
          Start with {p.name} today
        </h3>
        <p
          class="text-[13px] mb-6"
          style="color:rgba(var(--text-rgb) / 0.60)"
        >
          Get access to the full platform on secureye.io — or contact us
          for a personalised demo.
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="https://secureye.io"
            target="_blank"
            rel="noopener noreferrer"
            class="pd-cta-primary btn-primary text-[14px] inline-flex items-center justify-center gap-2"
          >
            Get Started Free <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
          </a>
          <a
            href="mailto:info@aquasecure.ai"
            class="pd-cta-outline btn-outline text-[14px] inline-flex items-center justify-center gap-2"
            style="color:var(--text)"
          >
            Request a Demo
          </a>
        </div>
        <p
          class="text-[11px] mt-4 text-center"
          style="color:rgba(var(--text-rgb) / 0.40)"
        >
          info@aquasecure.ai · aquasecure.ai
        </p>
      </div>
    </div>
  </div>
</section>

{/* ── Other Products ── */}
<section class="section-sm" style="background:var(--surface-2)">
  <div class="wrap">
    <p
      class="reveal text-center text-[13px] font-semibold mb-6"
      style="color:rgba(var(--text-rgb) / 0.55)"
    >
      Explore the full product suite
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      {
        others.map(([s, prod]) => (
          <a href={`/products/${s}`}>
            <div
              class="pd-related reveal flex items-center gap-2.5 px-4 py-2.5 rounded-xl border bg-white transition-all"
              style="border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 8px rgba(var(--accent-rgb) / 0.05)"
            >
              <div
                class="w-7 h-7 rounded-lg flex items-center justify-center"
                style={`background:${prod.bg}`}
              >
                <Icon
                  name={prod.icon}
                  class="w-3.5 h-3.5"
                  style={`color:${prod.color}`}
                  stroke-width={1.8}
                />
              </div>
              <span
                class="text-[13px] font-semibold"
                style="color:var(--text)"
              >
                {prod.name}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hero image entrance (framer fadeRight + hover lift) */
  .pd-hero-img > div {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pd-hero-img:hover > div {
    transform: translateY(-4px);
  }

  /* Primary CTA hover/tap (framer whileHover/whileTap) */
  .pd-cta-primary {
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .pd-cta-primary:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 28px rgba(var(--accent-rgb) / 0.55);
  }
  .pd-cta-primary:active {
    transform: scale(0.97);
  }

  /* Outline CTA hover (framer whileHover borderColor) */
  .pd-cta-outline {
    transition: border-color 0.15s;
  }
  .pd-cta-outline:hover {
    border-color: rgba(var(--accent-rgb) / 0.5);
  }

  /* Feature card hover lift (framer whileHover y/shadow/border) */
  .pd-feature {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .pd-feature:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 32px rgba(var(--accent-rgb) / 0.08);
    border-color: rgba(var(--accent-rgb) / 0.19);
  }

  /* "Talk to our team" arrow slide (framer whileHover x) */
  .pd-talk {
    transition: transform 0.15s;
  }
  .pd-talk:hover {
    transform: translateX(4px);
  }

  /* Related product chip hover (framer whileHover y/border/shadow) */
  .pd-related {
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .pd-related:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--accent-rgb) / 0.35);
    box-shadow: 0 6px 20px rgba(var(--accent-rgb) / 0.10);
  }
</style>

<script>
  function initProductDetail() {
    const root = document.querySelector('[data-product-detail]') || document.body;
    if (root.dataset.pdBound) return;
    root.dataset.pdBound = '1';
    // Reveal animation handled globally by Base.astro IntersectionObserver.
    // No additional client behaviour required (useReveal is a no-op).
  }
  initProductDetail();
  document.addEventListener('astro:page-load', initProductDetail);
</script>
