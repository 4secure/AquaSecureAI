---
/*
 * NetworkGraph — CloudSEK-style animated attack-path graph.
 * AI Model (left) -> mesh of asset/signal nodes -> Protected Org (right).
 * GSAP draws the mesh + attack paths on enter; a glowing pulse travels the
 * active path on a loop; nodes glow. Teal tokens only. Reduced-motion = static.
 */
import { Icon } from 'astro-icon/components';

const chips = ['Enumerate', 'Correlate', 'Prioritize', 'Respond'];

// Deterministic layout in a 1000 x 420 viewBox.
const NODES = [
  { id: 'ai', x: 70, y: 210, r: 10, hub: true },
  { id: 'a1', x: 250, y: 92, r: 5 },
  { id: 'a2', x: 232, y: 205, r: 6 },
  { id: 'a3', x: 268, y: 318, r: 5 },
  { id: 'b1', x: 430, y: 70, r: 5 },
  { id: 'b2', x: 472, y: 158, r: 6.5 },
  { id: 'b3', x: 442, y: 252, r: 5 },
  { id: 'b4', x: 492, y: 346, r: 5 },
  { id: 'c1', x: 640, y: 108, r: 5 },
  { id: 'c2', x: 620, y: 208, r: 6.5 },
  { id: 'c3', x: 662, y: 302, r: 5 },
  { id: 'd1', x: 792, y: 150, r: 5 },
  { id: 'd2', x: 800, y: 272, r: 5 },
  { id: 'target', x: 930, y: 210, r: 10, hub: true },
];
const N = Object.fromEntries(NODES.map((n) => [n.id, n]));

const EDGES = [
  ['ai', 'a1'], ['ai', 'a2'], ['ai', 'a3'],
  ['a1', 'a2'], ['a2', 'a3'],
  ['a1', 'b1'], ['a1', 'b2'], ['a2', 'b2'], ['a2', 'b3'], ['a3', 'b3'], ['a3', 'b4'],
  ['b1', 'b2'], ['b2', 'b3'], ['b3', 'b4'],
  ['b1', 'c1'], ['b2', 'c1'], ['b2', 'c2'], ['b3', 'c2'], ['b3', 'c3'], ['b4', 'c3'],
  ['c1', 'c2'], ['c2', 'c3'],
  ['c1', 'd1'], ['c2', 'd1'], ['c2', 'd2'], ['c3', 'd2'],
  ['d1', 'd2'], ['d1', 'target'], ['d2', 'target'],
];

// Highlighted attack paths (node id sequences).
const PATHS = [
  ['ai', 'a2', 'b2', 'c2', 'd1', 'target'],
  ['ai', 'a3', 'b3', 'c3', 'd2', 'target'],
  ['ai', 'a1', 'b1', 'c1', 'd1', 'target'],
];
const pathD = (ids) => ids.map((id, i) => `${i ? 'L' : 'M'} ${N[id].x} ${N[id].y}`).join(' ');
const aiPct = { x: (N.ai.x / 1000) * 100, y: (N.ai.y / 420) * 100 };
const tgPct = { x: (N.target.x / 1000) * 100, y: (N.target.y / 420) * 100 };
---

<section class="ng-section relative overflow-hidden section-sm">
  <div class="wrap relative z-10">
    <div class="text-center max-w-[640px] mx-auto mb-10">
      <div class="reveal flex justify-center mb-4"><span class="badge">Attack Surface</span></div>
      <h2 class="reveal delay-1 font-black tracking-tight mb-4" style="font-size:clamp(26px,3.4vw,42px);color:var(--text)">
        See the attack paths that <span class="tg">actually matter</span>
      </h2>
      <p class="reveal delay-2 text-lead" style="color:rgba(var(--text-rgb) / 0.6)">
        Aqua Secure AI traverses your environment the way an attacker would — mapping every asset and
        signal, then surfacing the exploitable paths to what matters, not theoretical alerts.
      </p>
    </div>

    <div class="ng-stage reveal delay-2 relative mx-auto" data-network-graph style="max-width:1000px">
      {/* Endpoint badges (kept inside the SVG aspect box via %) */}
      <div class="ng-badge ng-badge-l" style={`left:${aiPct.x}%;top:${aiPct.y}%`}>
        <span class="ng-badge-ico"><Icon name="lucide:brain-circuit" class="w-5 h-5" /></span>
        <span class="ng-badge-label">AI Model</span>
      </div>
      <div class="ng-badge ng-badge-r" style={`left:${tgPct.x}%;top:${tgPct.y}%`}>
        <span class="ng-badge-ico"><Icon name="lucide:building-2" class="w-5 h-5" /></span>
        <span class="ng-badge-label">Protected Org</span>
      </div>

      <svg class="ng-svg" viewBox="0 0 1000 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g class="ng-edges">
          {EDGES.map(([a, b]) => (
            <line class="edge" x1={N[a].x} y1={N[a].y} x2={N[b].x} y2={N[b].y} />
          ))}
        </g>
        <g class="ng-paths">
          {PATHS.map((ids, i) => <path class="apath" data-i={i} d={pathD(ids)} />)}
        </g>
        <g class="ng-nodes">
          {NODES.map((n) => <circle class:list={['node', { hub: n.hub }]} cx={n.x} cy={n.y} r={n.r} />)}
        </g>
        <circle class="pulse" r="4.5" cx={N.ai.x} cy={N.ai.y} />
      </svg>
    </div>

    <div class="reveal delay-3 flex flex-wrap justify-center gap-2 mt-8">
      {chips.map((c) => <span class="ng-chip">{c}</span>)}
    </div>
  </div>
</section>

<style>
  .ng-section { background: var(--bg); }
  .ng-stage { width: 100%; aspect-ratio: 1000 / 420; }
  .ng-svg { width: 100%; height: 100%; display: block; overflow: visible; }

  .edge {
    stroke: rgba(var(--accent-rgb) / 0.16);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .apath {
    fill: none;
    stroke: rgba(var(--accent-rgb) / 0.45);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .apath.active {
    stroke: var(--accent);
    stroke-width: 2.2;
    filter: drop-shadow(0 0 5px rgba(var(--accent-rgb) / 0.7));
  }
  .node {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 1.5;
    transition: filter .2s ease;
  }
  .node.hub {
    fill: var(--accent);
    filter: drop-shadow(0 0 8px rgba(var(--accent-rgb) / 0.6));
  }
  .node:hover { filter: drop-shadow(0 0 8px rgba(var(--accent-rgb) / 0.9)); cursor: pointer; }
  .pulse {
    fill: var(--accent-bright);
    filter: drop-shadow(0 0 6px rgba(var(--accent-rgb) / 0.9));
    opacity: 0;
  }

  /* Endpoint badges */
  .ng-badge {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    z-index: 2;
    pointer-events: none;
  }
  .ng-badge-ico {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 14px;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: var(--shadow-glow);
  }
  .ng-badge-label {
    font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: rgba(var(--text-rgb) / 0.7);
    background: rgba(var(--surface-rgb) / 0.7);
    backdrop-filter: blur(6px);
    padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--border);
  }

  .ng-chip {
    font-size: 12px; font-weight: 600;
    color: var(--accent);
    background: rgba(var(--accent-rgb) / 0.08);
    border: 1px solid rgba(var(--accent-rgb) / 0.22);
    padding: 6px 14px; border-radius: 999px;
  }

  @media (max-width: 640px) {
    .ng-badge-label { display: none; }
    .ng-badge-ico { width: 34px; height: 34px; border-radius: 10px; }
  }
</style>

<script>
  import { gsap, prefersReduced, isMobile, onReady } from '../../scripts/motion.js';

  function initNetworkGraph() {
    const root = document.querySelector('[data-network-graph]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';

    const edges = gsap.utils.toArray(root.querySelectorAll('.edge'));
    const paths = gsap.utils.toArray(root.querySelectorAll('.apath'));
    const nodes = gsap.utils.toArray(root.querySelectorAll('.node'));
    const pulse = root.querySelector('.pulse');

    if (prefersReduced()) {
      gsap.set([...edges, ...paths], { drawSVG: '100%' });
      if (pulse) pulse.style.display = 'none';
      return;
    }

    gsap.set(edges, { drawSVG: '0%' });
    gsap.set(paths, { drawSVG: '0%' });
    gsap.set(nodes, { opacity: 0, scale: 0, transformOrigin: 'center' });
    gsap.set(pulse, { opacity: 0 });

    const tl = gsap.timeline({ scrollTrigger: { trigger: root, start: 'top 78%', once: true } });
    tl.to(edges, { drawSVG: '100%', duration: 0.9, stagger: 0.02, ease: 'power2.out' })
      .to(nodes, { opacity: 1, scale: 1, duration: 0.5, stagger: 0.03, ease: 'back.out(1.6)' }, '-=0.65')
      .to(paths, { drawSVG: '100%', duration: 0.8, stagger: 0.15, ease: 'power2.out' }, '-=0.45')
      .add(() => { if (!isMobile()) startPulse(); });

    let i = 0;
    function startPulse() {
      if (!pulse) return;
      const run = () => {
        const p = paths[i % paths.length];
        i++;
        paths.forEach((pp) => pp.classList.remove('active'));
        p.classList.add('active');
        gsap.fromTo(pulse, { opacity: 0 }, { opacity: 1, duration: 0.25 });
        gsap.to(pulse, {
          duration: 2.3,
          ease: 'power1.inOut',
          motionPath: { path: p, align: p, alignOrigin: [0.5, 0.5] },
          onComplete: () => gsap.to(pulse, { opacity: 0, duration: 0.3, delay: 0.3, onComplete: run }),
        });
      };
      run();
    }
  }

  onReady(initNetworkGraph);
</script>
