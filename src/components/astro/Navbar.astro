---
import { Icon } from 'astro-icon/components';

const NAV = [
  { label: 'Home', href: '/', items: [] },
  {
    label: 'Products',
    href: '/products',
    items: [
      { l: 'GRC', h: '/products/grc' },
      { l: 'SOC', h: '/products/soc' },
      { l: 'Aqua SIEM', h: '/products/siem' },
      { l: 'Threat Intelligence', h: '/products/threat-intel' },
      { l: 'Asset Management', h: '/products/asset-management' },
      { l: 'Dark Web', h: '/products/dark-web' },
      { l: 'Phishbot', h: '/products/phishbot' },
    ],
  },
  {
    label: 'Solutions',
    href: '/solutions',
    items: [
      { l: 'Manage SIEM', h: '/solutions/manage-siem' },
      { l: 'Attack Surface', h: '/solutions/attack-surface' },
      { l: 'DMARC', h: '/solutions/dmarc' },
      { l: 'Phishing Campaigns', h: '/solutions/phishing-campaigns' },
      { l: 'E-learning', h: '/solutions/e-learning' },
      { l: 'Compliance Management', h: '/solutions/compliance-management' },
    ],
  },
  { label: 'Contact', href: '/contact', items: [] },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header id="site-nav" class="nav-header fixed left-0 right-0 z-50 transition-all duration-300">
  <div class="wrap flex items-center justify-between h-[66px]">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
      <img class="logo logo-top" src="/images/aquasecure_logo1.png" width="180" alt="Aqua Secure AI" />
      <img class="logo logo-scrolled" src="/images/Aquasecure_logo3.png" width="180" alt="Aqua Secure AI" />
    </a>

    {/* Desktop nav */}
    <nav class="hidden lg:flex items-center gap-0.5">
      {
        NAV.map((n) => (
          <div class="nav-item relative">
            <a
              href={n.href}
              class:list={['nav-pill flex items-center gap-1 text-[14px] px-3.5 py-2 rounded-lg', { 'is-active': isActive(n.href) }]}
            >
              {n.label}
              {n.items.length > 0 && <Icon name="lucide:chevron-down" class="chev w-3.5 h-3.5 opacity-50" />}
            </a>
            {n.items.length > 0 && (
              <div class="dropdown absolute top-full left-0 mt-2 py-1.5 rounded-2xl border z-50">
                {n.items.map((item) => (
                  <a href={item.h} class="drop-link flex items-center px-4 py-2.5 text-[13px] rounded-lg mx-1.5">
                    {item.l}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </nav>

    {/* CTAs */}
    <div class="hidden lg:flex items-center gap-2">
      <button type="button" class="theme-toggle p-2 rounded-lg transition-colors" data-theme-toggle aria-label="Toggle light/dark theme">
        <Icon name="lucide:moon" class="icon-moon w-[18px] h-[18px]" />
        <Icon name="lucide:sun" class="icon-sun w-[18px] h-[18px]" />
      </button>
      <a
        href="https://secureye.io/login"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-login text-[13px] font-medium transition-all duration-150 px-4 py-2 rounded-lg"
      >
        Login
      </a>
      <a
        href="https://secureye.io/get-started"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta text-[13px] font-semibold px-5 py-2.5 rounded-xl inline-flex items-center gap-1.5 text-white"
      >
        Get Started <Icon name="lucide:external-link" class="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Hamburger */}
    <button id="nav-burger" class="nav-burger lg:hidden p-2 rounded-lg z-50 transition-colors" aria-label="Menu">
      <Icon name="lucide:menu" class="burger-open w-5 h-5" />
      <Icon name="lucide:x" class="burger-close w-5 h-5" />
    </button>
  </div>
</header>

{/* Mobile drawer */}
<div id="nav-drawer" class="nav-drawer fixed inset-0 z-40 overflow-y-auto">
  <div class="flex flex-col items-center justify-center min-h-full py-20 gap-2">
    {
      NAV.map((n) => (
        <div class="w-full max-w-xs">
          <a
            href={n.href}
            class:list={['drawer-link text-[20px] font-bold block text-center py-2', { 'is-active': isActive(n.href) }]}
          >
            {n.label}
          </a>
          {n.items.length > 0 && (
            <div class="flex flex-col items-center gap-1 mt-1 mb-3">
              {n.items.map((item) => (
                <a href={item.h} class="drawer-sublink text-[13px] py-1">
                  {item.l}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
    <button type="button" class="drawer-theme-toggle mt-2 inline-flex items-center gap-2 text-[15px] font-medium" data-theme-toggle>
      <Icon name="lucide:moon" class="icon-moon w-[18px] h-[18px]" />
      <Icon name="lucide:sun" class="icon-sun w-[18px] h-[18px]" />
      <span class="theme-label-dark">Dark mode</span>
      <span class="theme-label-light">Light mode</span>
    </button>
    <a
      href="https://secureye.io/get-started"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 px-8 py-3 rounded-full font-semibold text-white inline-flex items-center gap-2"
      style="background:var(--grad-accent)"
    >
      Get Started <Icon name="lucide:arrow-right" class="w-4 h-4" />
    </a>
  </div>
</div>

<style>
  /* Entrance */
  @keyframes navDrop {
    from { transform: translateY(-80px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  .nav-header {
    top: var(--nav-top, 34px);
    background: transparent;
    animation: navDrop 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .nav-header.scrolled {
    top: 0;
    background: linear-gradient(135deg, rgba(var(--surface-rgb) / 0.92) 0%, rgba(var(--surface-rgb) / 0.95) 50%, rgba(var(--surface-rgb) / 0.92) 100%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(var(--accent-rgb) / 0.22);
    box-shadow: 0 4px 30px rgba(var(--border-rgb) / 0.20), 0 1px 0 rgba(var(--accent-rgb) / 0.12);
  }

  /* Logo swap */
  .logo { width: 180px; }
  .logo-top { filter: brightness(0.2) saturate(2); }
  :global(html.dark) .logo-top { filter: none; }
  .logo-scrolled { display: none; }
  .nav-header.scrolled .logo-top { display: none; }
  .nav-header.scrolled .logo-scrolled { display: inline; }

  /* Nav pills */
  .nav-pill {
    color: var(--text);
    font-weight: 500;
    background: transparent;
    transition: color .15s, background .15s;
  }
  .nav-pill:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.06); }
  .nav-pill.is-active { color: var(--accent); background: rgba(var(--accent-rgb) / 0.08); font-weight: 600; }
  .nav-header.scrolled .nav-pill { color: rgba(var(--text-rgb) / 0.75); }
  .nav-header.scrolled .nav-pill:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.12); }
  .nav-header.scrolled .nav-pill.is-active { color: var(--accent); background: rgba(var(--accent-rgb) / 0.18); }

  .chev { transition: transform .18s; }
  .nav-item:hover .chev { transform: rotate(180deg); }

  /* Dropdown */
  .dropdown {
    min-width: 220px;
    background: var(--surface);
    border-color: rgba(var(--accent-rgb) / 0.22);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(var(--accent-rgb) / 0.10);
    backdrop-filter: blur(20px);
    opacity: 0; visibility: hidden;
    transform: translateY(8px) scale(0.97);
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
  }
  .nav-item:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
  .drop-link { color: rgba(var(--text-rgb) / 0.65); font-weight: 500; transition: all .15s; }
  .drop-link:hover { color: var(--text); background: rgba(var(--accent-rgb) / 0.10); }

  /* Login link */
  .nav-login { color: var(--accent); background: transparent; }
  .nav-login:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.07); }
  .nav-header.scrolled .nav-login { color: rgba(var(--text-rgb) / 0.65); }
  .nav-header.scrolled .nav-login:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.12); }

  /* CTA button */
  .nav-cta {
    background: linear-gradient(135deg,var(--accent),var(--accent-hover));
    box-shadow: 0 2px 12px rgba(var(--accent-rgb) / 0.38);
    transition: transform .15s, box-shadow .15s;
  }
  .nav-cta:hover { transform: scale(1.04); box-shadow: 0 4px 20px rgba(var(--accent-rgb) / 0.60); }
  .nav-cta:active { transform: scale(0.96); }

  /* Hamburger */
  .nav-burger { color: var(--accent); }
  .nav-burger:hover { background: rgba(var(--accent-rgb) / 0.10); }
  .nav-header.scrolled .nav-burger { color: var(--text); }
  .burger-close { display: none; }
  body.drawer-open .burger-open { display: none; }
  body.drawer-open .burger-close { display: inline; }

  /* Mobile drawer */
  .nav-drawer {
    background: var(--bg);
    transform: translateX(100%);
    transition: transform .3s cubic-bezier(0.16,1,0.3,1);
  }
  body.drawer-open .nav-drawer { transform: translateX(0); }
  .drawer-link { color: rgba(var(--text-rgb) / 0.85); transition: color .15s; }
  .drawer-link:hover, .drawer-link.is-active { color: var(--accent); }
  .drawer-sublink { color: rgba(var(--text-rgb) / 0.45); transition: color .15s; }
  .drawer-sublink:hover { color: var(--accent-light); }

  /* Theme toggle — icon + label swap by current theme */
  .theme-toggle { color: var(--text); }
  .theme-toggle:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.06); }
  .nav-header.scrolled .theme-toggle { color: rgba(var(--text-rgb) / 0.75); }
  .nav-header.scrolled .theme-toggle:hover { color: var(--accent); background: rgba(var(--accent-rgb) / 0.12); }
  .theme-toggle .icon-sun,
  .drawer-theme-toggle .icon-sun,
  .drawer-theme-toggle .theme-label-light { display: none; }
  :global(html.dark) .theme-toggle .icon-moon,
  :global(html.dark) .drawer-theme-toggle .icon-moon,
  :global(html.dark) .drawer-theme-toggle .theme-label-dark { display: none; }
  :global(html.dark) .theme-toggle .icon-sun,
  :global(html.dark) .drawer-theme-toggle .icon-sun,
  :global(html.dark) .drawer-theme-toggle .theme-label-light { display: inline-block; }

  .drawer-theme-toggle { color: rgba(var(--text-rgb) / 0.85); }
</style>

<script>
  function initNav() {
    const header = document.getElementById('site-nav');
    const burger = document.getElementById('nav-burger');
    const drawer = document.getElementById('nav-drawer');
    if (!header) return;

    const bar = document.getElementById('announce-bar');
    const update = () => {
      const scrolled = window.scrollY > 60;
      header.classList.toggle('scrolled', scrolled);
      const barVisible = bar && getComputedStyle(bar).display !== 'none';
      const top = scrolled ? 0 : barVisible ? bar.offsetHeight : 0;
      header.style.setProperty('--nav-top', top + 'px');
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('aqua:bar-dismissed', update);

    if (burger && drawer) {
      burger.addEventListener('click', () => document.body.classList.toggle('drawer-open'));
      drawer.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => document.body.classList.remove('drawer-open'))
      );
    }

    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.themeBound) return;
      btn.dataset.themeBound = '1';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    });
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
