---
// Announcement bar — from the AquaSecure Home design.
---
<div class="d-announce">
  <span class="d-announce-dot"></span>
  <span>AQUA TIP is live — 1 free real-time threat intel search every day.</span>
  <a href="https://tip.aquasecure.ai" target="_blank" rel="noopener">Try it free →</a>
</div>

<style>
  .d-announce {
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--grad-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .01em;
    position: relative;
    overflow: hidden;
    z-index: 60;
    padding: 0 16px;
    text-align: center;
  }
  .d-announce-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 8px #fff; flex-shrink: 0;
  }
  .d-announce a { color: #fff; font-weight: 800; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 520px) { .d-announce a { display: none; } }
</style>
