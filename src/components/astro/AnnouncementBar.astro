---
import { Icon } from 'astro-icon/components';
---

<div id="announce-bar" class="announce-bar hidden sm:block relative z-[60] overflow-hidden border-b">
  <div class="wrap flex items-center justify-center gap-2.5 py-2 text-[12px] font-medium relative announce-text">
    <span class="hidden sm:inline">🛡️</span>
    <span>
      Aqua Secure AI — Modern SOC Operations Empowering Human analysts.{' '}
      <strong style="color:var(--accent-light)">PREVENT → DETECT → RESPOND</strong>
    </span>
    <a
      href="https://secureye.io/get-started"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 underline underline-offset-2 opacity-75 hover:opacity-100 whitespace-nowrap"
    >
      Get Started <Icon name="lucide:arrow-right" class="w-3 h-3" />
    </a>
  </div>
  <button id="announce-close" class="absolute right-3 top-1/2 -translate-y-1/2 opacity-50 hover:opacity-100 announce-text" aria-label="Dismiss">
    <Icon name="lucide:x" class="w-3.5 h-3.5" />
  </button>
</div>

<style>
  .announce-bar {
    background: linear-gradient(90deg,var(--surface-2),var(--surface-2),var(--surface-2),var(--surface-2),var(--surface-2));
    background-size: 200% 100%;
    border-color: rgba(var(--border-rgb) / 0.3);
    transition: height .28s ease, opacity .28s ease;
  }
  .announce-text { color: rgba(var(--text-rgb) / 0.9); }
</style>

<script>
  function initAnnounce() {
    const bar = document.getElementById('announce-bar');
    const close = document.getElementById('announce-close');
    if (!bar || !close || close.dataset.bound) return;
    close.dataset.bound = '1';
    close.addEventListener('click', () => {
      bar.style.display = 'none';
      window.dispatchEvent(new CustomEvent('aqua:bar-dismissed'));
    });
  }
  initAnnounce();
  document.addEventListener('astro:page-load', initAnnounce);
</script>
