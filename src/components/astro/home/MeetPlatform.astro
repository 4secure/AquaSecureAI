---
import { Icon } from 'astro-icon/components';

// MeetPlatform: light purple themed background — white cards on lavender
const DOT = { purple: 'var(--accent)', blue: '#0EA5E9', green: '#10B981', amber: '#F59E0B', red: '#EF4444', dim: 'var(--accent-hover)' };
const mkDots = (n, color, xFn) => Array(n).fill(0).map((_, i) => ({ x: xFn(i), size: 7 + Math.random() * 4, color, delay: Math.random() * 2, duration: 3 + Math.random() }));
const aiDots = mkDots(18, DOT.purple, i => 2 + (i * 5.3) % 96);
const threatDots = mkDots(20, DOT.amber, i => 2 + (i * 4.8) % 96);
const unifiedDots = Array(35).fill(0).map((_, i) => ({ x: 5 + (i * 2.5) % 90, size: 7 + Math.random() * 4, color: [DOT.purple, DOT.red, DOT.dim, DOT.green][i % 4], delay: Math.random() * 2, duration: 3 + Math.random() }));
const managedDots = (() => {
  const d = [], p = [DOT.purple, DOT.dim, DOT.green, DOT.blue, DOT.amber, DOT.red];
  for (let b = 0; b < 13; b++) { const bx = 2 + b * 8, dl = Math.random() * 2, dr = 3 + Math.random();[{ x: bx - .5, y: 30 }, { x: bx + 1, y: 30 }, { x: bx - 1, y: 40 }, { x: bx + .5, y: 40 }].forEach((pos, idx) => d.push({ x: pos.x, y: pos.y, size: 7 + Math.random() * 4, color: p[(b * 4 + idx) % 6], delay: dl, duration: dr })); }
  return d;
})();

const cols = [...Array(8)].map((_, i) => i);
const rows = [...Array(6)].map((_, i) => i);
---

<section id="platform" class="relative overflow-hidden py-16 pb-20" style="background:var(--surface-2)">
  {/* Subtle radial tint */}
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 70% 60% at 50% 50%, rgba(var(--accent-rgb) / 0.08) 0%, transparent 70%)"></div>

  <div class="wrap relative z-10">
    <div class="reveal text-center mb-10">
      <span class="inline-block text-[11px] font-bold uppercase tracking-widest mb-3 px-3 py-1 rounded-full" style="background:rgba(var(--accent-rgb) / 0.10);color:rgba(var(--accent-rgb) / 0.70);border:1px solid rgba(var(--accent-rgb) / 0.20)">Platform</span>
      <h2 class="font-extrabold tracking-tight leading-tight mb-3" style="font-size:clamp(24px,3.5vw,42px);color:var(--text)">
        Modern SOC Operations{' '}
        <span style="background:linear-gradient(135deg,var(--accent),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Empowering Human</span>
      </h2>
      <p class="text-[15px] max-w-[500px] mx-auto" style="color:rgba(var(--text-rgb) / 0.65)">Threat Intelligence, Managed Services — unified in one platform.</p>
    </div>

    <div class="max-w-[680px] mx-auto space-y-3">
      <div class="mp-card reveal rounded-xl border transition-all duration-300" style="background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 16px rgba(var(--accent-rgb) / 0.07)">
        <div class="flex items-center justify-between px-4 py-3">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)"><Icon name="lucide:menu" width={14} height={14} style="color:var(--accent)" /></div>
            <span class="text-[13px] font-semibold" style="color:var(--text)">SOC Analyst</span>
          </div>
          <span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">Investigation and Case Management</span>
        </div>
      </div>

      <div class="mp-card reveal rounded-xl border transition-all duration-300" style="background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 16px rgba(var(--accent-rgb) / 0.07)">
        <div class="px-4 pt-4 pb-3">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between mb-1">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)"><Icon name="lucide:refresh-cw" width={14} height={14} style="color:var(--accent)" /></div>
              <span class="text-[13px] font-semibold" style="color:var(--text)">Managed Services</span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              <div class="flex gap-0.5 mr-1"><Icon name="lucide:chevron-up" width={13} height={13} style="color:rgba(var(--accent-rgb) / 0.4)" /><Icon name="lucide:chevron-down" width={13} height={13} style="color:rgba(var(--accent-rgb) / 0.4)" /></div>
              {['Incident Creation', 'Workflow', 'Detection and Response'].map(t => (
                <span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">{t}</span>
              ))}
            </div>
          </div>
          <div class="relative h-24 mt-3 overflow-hidden rounded-xl border" style="background:var(--surface-2);border-color:rgba(var(--accent-rgb) / 0.12)">
            <div class="absolute inset-0 pointer-events-none">
              {cols.map(i => <div class="absolute top-0 h-full w-px" style={`left:${i * 12.5}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
              {rows.map(i => <div class="absolute left-0 w-full h-px" style={`top:${i * 16.6}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
            </div>
            {managedDots.map(dot => <div class="absolute rounded-full bounce-dot" style={`left:${dot.x}%;top:${dot.y ? `${dot.y}%` : '5px'};width:${dot.size}px;height:${dot.size}px;transform:translate(-50%,-50%);background:${dot.color};box-shadow:0 0 6px ${dot.color}60;--duration:${dot.duration}s;--delay:${dot.delay}s;filter:blur(0.3px)`} />)}
          </div>
        </div>
      </div>

      <div class="mp-card reveal rounded-xl border transition-all duration-300" style="background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 16px rgba(var(--accent-rgb) / 0.07)">
        <div class="px-4 pt-4 pb-3">
          {/* <div className="flex items-center justify-center gap-2 mb-4">
            {['PREVENT','DETECT','RESPOND'].map((s,i)=>(
              <React.Fragment key={s}>
                <motion.span className="text-[11px] font-black tracking-widest cursor-default" style={{color:['var(--accent)','#0EA5E9','#10B981'][i]}} animate={{opacity:[.55,1,.55]}} transition={{duration:2,repeat:Infinity,delay:i*.5}}>{s}</motion.span>
                {i<2&&<span style={{color:'rgba(var(--accent-rgb) / 0.28)',fontSize:11}}>→</span>}
              </React.Fragment>
            ))}
          </div> */}

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)"><Icon name="lucide:cpu" width={14} height={14} style="color:var(--accent)" /></div>
                <span class="text-[13px] font-semibold" style="color:var(--text)">AI Secops</span>
              </div>
              <div class="mb-2"><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">Data Enrichment Prioritization</span></div>
              <div class="relative h-24 mt-3 overflow-hidden rounded-xl border" style="background:var(--surface-2);border-color:rgba(var(--accent-rgb) / 0.12)">
                <div class="absolute inset-0 pointer-events-none">
                  {cols.map(i => <div class="absolute top-0 h-full w-px" style={`left:${i * 12.5}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
                  {rows.map(i => <div class="absolute left-0 w-full h-px" style={`top:${i * 16.6}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
                </div>
                {aiDots.map(dot => <div class="absolute rounded-full bounce-dot" style={`left:${dot.x}%;top:${dot.y ? `${dot.y}%` : '5px'};width:${dot.size}px;height:${dot.size}px;transform:translate(-50%,-50%);background:${dot.color};box-shadow:0 0 6px ${dot.color}60;--duration:${dot.duration}s;--delay:${dot.delay}s;filter:blur(0.3px)`} />)}
              </div>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2">
                <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)"><Icon name="lucide:trending-up" width={14} height={14} style="color:var(--accent)" /></div>
                <span class="text-[13px] font-semibold" style="color:var(--text)">Threat Intel</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mb-2"><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">Real Time Threat Intel</span><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">Advance Correlation</span></div>
              <div class="relative h-24 mt-3 overflow-hidden rounded-xl border" style="background:var(--surface-2);border-color:rgba(var(--accent-rgb) / 0.12)">
                <div class="absolute inset-0 pointer-events-none">
                  {cols.map(i => <div class="absolute top-0 h-full w-px" style={`left:${i * 12.5}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
                  {rows.map(i => <div class="absolute left-0 w-full h-px" style={`top:${i * 16.6}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
                </div>
                {threatDots.map(dot => <div class="absolute rounded-full bounce-dot" style={`left:${dot.x}%;top:${dot.y ? `${dot.y}%` : '5px'};width:${dot.size}px;height:${dot.size}px;transform:translate(-50%,-50%);background:${dot.color};box-shadow:0 0 6px ${dot.color}60;--duration:${dot.duration}s;--delay:${dot.delay}s;filter:blur(0.3px)`} />)}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mp-card reveal rounded-xl border transition-all duration-300" style="background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 16px rgba(var(--accent-rgb) / 0.07)">
        <div class="px-4 pt-4 pb-3">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)"><Icon name="lucide:clock" width={14} height={14} style="color:var(--accent)" /></div>
            <span class="text-[13px] font-semibold" style="color:var(--text)">Unified Incoming Data</span>
          </div>
          <div class="relative h-24 mt-3 overflow-hidden rounded-xl border" style="background:var(--surface-2);border-color:rgba(var(--accent-rgb) / 0.12)">
            <div class="absolute inset-0 pointer-events-none">
              {cols.map(i => <div class="absolute top-0 h-full w-px" style={`left:${i * 12.5}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
              {rows.map(i => <div class="absolute left-0 w-full h-px" style={`top:${i * 16.6}%;background:rgba(var(--accent-rgb) / 0.06)`} />)}
            </div>
            {unifiedDots.map(dot => <div class="absolute rounded-full bounce-dot" style={`left:${dot.x}%;top:${dot.y ? `${dot.y}%` : '5px'};width:${dot.size}px;height:${dot.size}px;transform:translate(-50%,-50%);background:${dot.color};box-shadow:0 0 6px ${dot.color}60;--duration:${dot.duration}s;--delay:${dot.delay}s;filter:blur(0.3px)`} />)}
          </div>
        </div>
      </div>

      <div class="mp-card reveal rounded-xl border transition-all duration-300" style="background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 16px rgba(var(--accent-rgb) / 0.07)">
        <div class="px-4 py-4">
          <div class="flex flex-col items-center gap-4 md:flex-row md:justify-center">
            <div class="text-center"><p class="text-[10px] font-bold uppercase tracking-widest mb-2.5" style="color:rgba(var(--accent-rgb) / 0.48)">Security Data Model</p><div class="flex gap-2"><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">TABULAR</span><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">VECTOR</span></div></div>
            <div class="hidden md:flex items-center w-24 overflow-hidden h-px relative"><div class="absolute inset-0" style="background:rgba(var(--accent-rgb) / 0.18)"></div><div class="mp-scan absolute h-full w-1/2 rounded-full" style="background:linear-gradient(90deg,transparent,var(--accent),transparent)"></div></div>
            <div class="text-center"><p class="text-[10px] font-bold uppercase tracking-widest mb-2.5" style="color:rgba(var(--accent-rgb) / 0.48)">Data Lake</p><div class="flex gap-2"><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">RAW</span><span class="mp-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold whitespace-nowrap select-none cursor-default transition-all duration-150" style="background:rgba(var(--accent-rgb) / 0.10);color:var(--accent-hover);border:1px solid rgba(var(--accent-rgb) / 0.22)">NORMALIZE</span></div></div>
          </div>
          <p class="text-center text-[11px] mt-3" style="color:rgba(var(--accent-rgb) / 0.42)">Incoming raw data from different sources</p>
        </div>
      </div>
    </div>
  </div>
  {/* Smooth fade to dark for HowItWorks below */}
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="height:280px;background:linear-gradient(to bottom, transparent 0%, rgba(var(--bg-rgb) / 0.3) 40%, rgba(var(--bg-rgb) / 0.7) 65%, var(--bg) 100%)"></div>
</section>

<style>
  @keyframes bounceUpDown { 0%,100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(52px); opacity: 0.35; } }
  .bounce-dot { animation: bounceUpDown var(--duration,3s) cubic-bezier(0.42,0,0.58,1) infinite; animation-delay: var(--delay,0s); will-change: transform; }

  /* Badge hover (React onMouseEnter/onMouseLeave) */
  .mp-badge:hover { background: rgba(var(--accent-rgb) / 0.18) !important; }

  /* Card hover (React onMouseEnter/onMouseLeave) */
  .mp-card:hover { border-color: rgba(var(--accent-rgb) / 0.35) !important; box-shadow: 0 4px 24px rgba(var(--accent-rgb) / 0.14) !important; }

  /* Scanning bar (framer-motion x:['-100%','200%'] loop) */
  @keyframes mpScan { from { transform: translateX(-100%); } to { transform: translateX(200%); } }
  .mp-scan { animation: mpScan 2s linear infinite; }
</style>
