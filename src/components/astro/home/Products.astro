---
import { Icon } from 'astro-icon/components';

const COLOR = 'var(--accent)';
const COLOR2 = 'var(--accent-hover)';

const PRODUCTS_DATA = [
  { icon: 'lucide:database',     slug: 'siem',             name: 'Aqua SIEM',          tagline: 'Security Information & Event Management', tags: ['Log Management', 'Event Correlation', 'Real-time Alerts', 'Compliance Reports'] },
  { icon: 'lucide:activity',     slug: 'soc',              name: 'SOC',                tagline: 'Security Operations Center',             tags: ['24/7 Monitoring', 'Incident Response', 'Case Management', 'Threat Hunting'] },
  { icon: 'lucide:globe',        slug: 'threat-intel',     name: 'Threat Intelligence', tagline: 'Global Cyber Threat Intel',              tags: ['IP Reputation', 'IOC Feeds', 'Threat Classification', 'Risk Scoring'] },
  { icon: 'lucide:wifi',         slug: 'dark-web',         name: 'Dark Web',            tagline: 'Dark Web Monitoring & Intelligence',     tags: ['Credential Monitoring', 'Breach Detection', 'Brand Protection', 'Leak Alerts'] },
  { icon: 'lucide:bug',          slug: 'phishbot',         name: 'Phishbot',            tagline: 'Phishing Campaign Management',           tags: ['Phishing Simulations', 'Employee Training', 'Click Tracking', 'Campaign Builder'] },
  { icon: 'lucide:box',          slug: 'asset-management', name: 'Asset Management',    tagline: 'Unified Asset Inventory',               tags: ['Asset Discovery', 'Ownership Tracking', 'Risk Scoring', 'CMDB Integration'] },
  { icon: 'lucide:shield-check', slug: 'grc',              name: 'GRC',                tagline: 'Governance, Risk & Compliance',          tags: ['CTDISR', 'PCI-DSS', 'ISO 27001'] },
];

const topRow = PRODUCTS_DATA.slice(0, 4);
const bottomRow = PRODUCTS_DATA.slice(4);
---

<section id="products" class="section relative overflow-hidden" style="background:var(--surface)">
  <div class="absolute inset-0 pointer-events-none opacity-20" style="background-image:radial-gradient(circle, rgba(var(--accent-rgb) / 0.20) 1px, transparent 1px);background-size:28px 28px"></div>
  <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(180deg, transparent 60%, rgba(var(--accent-rgb) / 0.04) 100%)"></div>

  <div class="wrap relative z-10">
    <div class="text-center mb-12">
      <p class="reveal delay-1 inline-block text-[11px] font-bold uppercase tracking-widest mb-4 px-3 py-1 rounded-full" style="background:rgba(var(--accent-rgb) / 0.08);color:rgba(var(--accent-rgb) / 0.70);border:1px solid rgba(var(--accent-rgb) / 0.18)">
        Products
      </p>
      <h2 class="reveal delay-2 font-extrabold tracking-tight leading-tight mb-4" style="font-size:clamp(26px,3.8vw,44px);color:var(--text)">
        Secure your organisation with our{' '}
        <span style="background:linear-gradient(135deg,var(--accent) 0%,var(--accent) 50%,var(--accent-hover) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
          complete product suite
        </span>
      </h2>
      <p class="reveal delay-3 text-lead max-w-[520px] mx-auto" style="color:rgba(var(--text-rgb) / 0.60)">
        Seven purpose-built modules — use them independently or as a unified AI-powered platform.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
      {
        topRow.map((p) => (
          <a href={`/products/${p.slug}`} class="block h-full">
            <div class="product-card group relative rounded-2xl flex flex-col gap-3 cursor-pointer overflow-hidden h-full reveal" style="padding:20px;background:var(--surface);border:1.5px solid rgba(var(--accent-rgb) / 0.15);box-shadow:0 2px 12px rgba(var(--accent-rgb) / 0.06)">
              {/* Gradient bg on hover */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background:linear-gradient(135deg, rgba(var(--accent-rgb) / 0.07) 0%, rgba(var(--border-rgb) / 0.12) 100%)"></div>

              {/* Icon */}
              <div class="product-icon w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative z-10" style="background:rgba(var(--accent-rgb) / 0.10)">
                <Icon name={p.icon} class="w-5 h-5" style={`color:${COLOR}`} />
              </div>

              {/* Name + tagline */}
              <div class="relative z-10">
                <h3 class="text-[15px] font-extrabold mb-0.5" style="color:var(--text)">{p.name}</h3>
                <p class="text-[10px] font-bold uppercase tracking-wider leading-tight" style={`color:${COLOR}`}>{p.tagline}</p>
              </div>

              {/* Tags */}
              <div class="flex flex-wrap gap-1.5 relative z-10">
                {p.tags.map((t) => (
                  <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full" style={`background:rgba(var(--accent-rgb) / 0.08);color:${COLOR};border:1px solid rgba(var(--accent-rgb) / 0.20)`}>
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {
        bottomRow.map((p) => (
          <a href={`/products/${p.slug}`} class="block h-full">
            <div class="product-card group relative rounded-2xl flex flex-col gap-3 cursor-pointer overflow-hidden h-full reveal" style="padding:18px;background:var(--surface);border:1.5px solid rgba(var(--accent-rgb) / 0.15);box-shadow:0 2px 12px rgba(var(--accent-rgb) / 0.06)">
              {/* Gradient bg on hover */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background:linear-gradient(135deg, rgba(var(--accent-rgb) / 0.07) 0%, rgba(var(--border-rgb) / 0.12) 100%)"></div>

              {/* Icon + name row */}
              <div class="flex items-center gap-3 relative z-10">
                <div class="product-icon w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(var(--accent-rgb) / 0.10)">
                  <Icon name={p.icon} class="w-5 h-5" style={`color:${COLOR}`} />
                </div>
                <div>
                  <h3 class="text-[15px] font-extrabold" style="color:var(--text)">{p.name}</h3>
                  <p class="text-[10px] font-bold uppercase tracking-wider" style={`color:${COLOR}`}>{p.tagline}</p>
                </div>
              </div>

              {/* Tags */}
              <div class="flex flex-wrap gap-1.5 relative z-10">
                {p.tags.map((t) => (
                  <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full" style={`background:rgba(var(--accent-rgb) / 0.08);color:${COLOR};border:1px solid rgba(var(--accent-rgb) / 0.20)`}>
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product-card {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(var(--accent-rgb) / 0.18), 0 0 0 1.5px rgba(var(--accent-rgb) / 0.40);
  }
  .product-icon {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-card:hover .product-icon {
    transform: scale(1.12) rotate(6deg);
  }
</style>
