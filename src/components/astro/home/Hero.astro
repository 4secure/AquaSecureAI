---
import { Icon } from 'astro-icon/components';

const GRC = [
  { id: 'ETGRM', name: 'ETGRM' },
  { id: 'CTDISR', name: 'CTDISR' },
  { id: 'iso', name: 'ISO 27001' },
];
const badges = ['SOC', 'GRC', 'Threat Intel'];
const bullets = [
  'AI-powered 24/7 threat detection and response',
  'Real-time threat intelligence with global feeds',
];
---

<section id="home" class="relative overflow-hidden" style="background:var(--surface);min-height:100vh">
  {/* Dot grid */}
  <div class="absolute inset-0 pointer-events-none opacity-35" style="background-image:radial-gradient(circle, rgba(var(--accent-rgb) / 0.18) 1px, transparent 1px);background-size:28px 28px"></div>

  <div class="wrap relative z-10 w-full" style="padding-top:calc(66px + 1rem);padding-bottom:3rem">
    <div class="grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-10 lg:gap-14 items-center">
      {/* LEFT */}
      <div>
        <div class="reveal delay-1 flex items-center gap-2 mb-4">
          {
            badges.map((s, i) => (
              <span class="flex items-center gap-2">
                <span
                  class="text-[10px] font-bold tracking-widest uppercase"
                  style={`color:${i === 0 ? 'var(--text)' : i === 1 ? 'var(--accent)' : 'rgba(var(--text-rgb) / 0.40)'}`}
                >
                  {s}
                </span>
                {i < badges.length - 1 && <span style="color:rgba(var(--accent-rgb) / 0.28)">▸</span>}
              </span>
            ))
          }
        </div>

        <div class="reveal delay-2">
          <h1 class="font-black leading-[1.1] tracking-tight" style="font-size:clamp(26px,3.8vw,44px);color:var(--text)">
            Modern Soc Operations
          </h1>
          <h1 class="font-black leading-[1.1] tracking-tight mb-3" style="font-size:clamp(26px,3.8vw,44px)">
            <span style="background:linear-gradient(135deg,var(--accent) 0%,var(--accent) 50%,var(--accent-hover) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
              Empowering Human
            </span>
          </h1>
        </div>

        <p class="reveal delay-3 font-semibold mb-4" style="font-size:15px;min-height:1.4rem;color:rgba(var(--text-rgb) / 0.55)">
          <span style="color:rgba(var(--text-rgb) / 0.35)">for </span>
          <span id="hero-typed" style="background:linear-gradient(135deg,var(--accent),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"></span>
          <span class="animate-blink ml-0.5" style="color:var(--accent)">|</span>
        </p>

        <p class="reveal delay-3 text-lead leading-[1.8] mb-5" style="color:rgba(var(--text-rgb) / 0.60)">
          Aqua Secure AI empowers human SOC analysts with AI-powered monitoring, automated response, and global threat intelligence.
        </p>

        <div class="reveal delay-4 flex flex-col gap-2 mb-6">
          {
            bullets.map((p) => (
              <div class="flex items-start gap-2.5">
                <span class="w-3.5 h-3.5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(var(--accent-rgb) / 0.10)">
                  <Icon name="lucide:shield-check" class="w-2 h-2" style="color:var(--accent)" />
                </span>
                <span style="font-size:13px;color:rgba(var(--text-rgb) / 0.65)">{p}</span>
              </div>
            ))
          }
        </div>

        <div class="reveal delay-4 flex flex-wrap gap-3 mb-5">
          <a
            href="https://secureye.io/get-started"
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-semibold text-[13px] text-white"
            style="background:linear-gradient(135deg,var(--accent),var(--accent-hover));box-shadow:0 4px 18px rgba(var(--accent-rgb) / 0.35)"
          >
            Get Started <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>

        <div class="reveal delay-5 flex flex-wrap items-center gap-1.5 mb-4">
          <span style="font-size:11px;color:rgba(var(--text-rgb) / 0.38)">GRC:</span>
          {
            GRC.map((f) => (
              <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-pill" style="background:rgba(var(--accent-rgb) / 0.12);color:var(--accent);border:1px solid rgba(var(--accent-rgb) / 0.28)">
                {f.name}
              </span>
            ))
          }
        </div>

        <p class="reveal delay-5" style="font-size:11px;color:rgba(var(--text-rgb) / 0.35)">
          Managed services available ·{' '}
          <a href="mailto:info@aquasecure.ai" class="hover:underline" style="color:rgba(var(--text-rgb) / 0.55)">info@aquasecure.ai</a>
        </p>
      </div>

      {/* RIGHT: dashboard screenshot */}
      <div class="hero-img relative flex justify-end">
        <div class="absolute -inset-6 pointer-events-none rounded-3xl" data-parallax="16" style="background:radial-gradient(ellipse 80% 70% at 55% 50%, rgba(var(--accent-rgb) / 0.10) 0%, transparent 70%)"></div>

        <div class="relative w-full" style="max-width:640px">
          {/* Browser chrome */}
          <div class="rounded-t-2xl px-4 py-2.5 flex items-center gap-2" style="background:var(--surface-2);border:1px solid rgba(var(--accent-rgb) / 0.18);border-bottom:none">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full" style="background:#FF605C"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background:#FFBD44"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background:#00CA4E"></div>
            </div>
            <div class="flex-1 mx-3 h-5 rounded-md flex items-center px-2.5 gap-1.5" style="background:rgba(var(--accent-rgb) / 0.08);border:1px solid rgba(var(--accent-rgb) / 0.12)">
              <div class="w-2 h-2 rounded-full" style="background:rgba(var(--accent-rgb) / 0.35)"></div>
              <span class="text-[9px] font-medium" style="color:rgba(var(--text-rgb) / 0.55)">secureye.io/dashboard</span>
            </div>
          </div>

          {/* Screenshot */}
          <div class="overflow-hidden rounded-b-2xl" style="border:1px solid rgba(var(--accent-rgb) / 0.18);box-shadow:0 24px 64px rgba(var(--accent-rgb) / 0.14), 0 8px 24px rgba(0,0,0,0.08)">
            <img src="/images/dashboard-hero.jpg" alt="Aqua Secure AI Dashboard" class="w-full block" style="display:block" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-cta { transition: transform .15s, box-shadow .15s; }
  .hero-cta:hover { transform: scale(1.04); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / 0.55); }
  .hero-cta:active { transform: scale(0.97); }

  @keyframes heroSlideIn {
    from { opacity: 0; transform: translate(40px, 8px); }
    to   { opacity: 1; transform: translate(0, 0); }
  }
  .hero-img { animation: heroSlideIn 0.9s cubic-bezier(0.16,1,0.3,1) 0.25s both; }
</style>

<script>
  function initHeroTyping() {
    const el = document.getElementById('hero-typed');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';
    const words = ['GRC Compliance', 'SOC Operations', 'Threat Intelligence'];
    const speed = 78, pause = 2400;
    let wi = 0, ci = 0, deleting = false;
    const tick = () => {
      const w = words[wi];
      if (!deleting) {
        el.textContent = w.slice(0, ci);
        if (ci <= w.length) { ci++; setTimeout(tick, speed); }
        else setTimeout(() => { deleting = true; tick(); }, pause);
      } else {
        el.textContent = w.slice(0, ci);
        if (ci > 0) { ci--; setTimeout(tick, speed / 2); }
        else { deleting = false; wi = (wi + 1) % words.length; ci = 0; setTimeout(tick, speed); }
      }
    };
    tick();
  }
  initHeroTyping();
  document.addEventListener('astro:page-load', initHeroTyping);
</script>
