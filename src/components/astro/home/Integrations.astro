---
import { Icon } from 'astro-icon/components';

const features = [
  {
    icon: 'lucide:search', color: 'var(--accent)', bg: 'rgba(var(--accent-rgb) / 0.08)',
    title: 'Real-Time IP Lookup',
    desc: 'Query any IP address against global threat intelligence feeds for instant reputation scoring.',
  },
  {
    icon: 'lucide:shield', color: '#0284C7', bg: 'rgba(2,132,199,0.08)',
    title: 'Threat Classification',
    desc: 'Categorize threats by type — malware, botnet, scanner, brute-force — with confidence levels.',
  },
  {
    icon: 'lucide:activity', color: '#059669', bg: 'rgba(5,150,105,0.08)',
    title: 'Risk Scoring',
    desc: 'Get a unified risk score aggregated from multiple intelligence sources and enrichment data.',
  },
];
---

<section id="integrations" class="relative overflow-hidden py-20"
  style="background:var(--surface-2)">

  {/* Background tints */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-0 -left-48 w-96 h-96 rounded-full"
      style="background:rgba(var(--accent-rgb) / 0.06);filter:blur(100px)"></div>
    <div class="absolute bottom-0 -right-48 w-96 h-96 rounded-full"
      style="background:rgba(var(--accent-rgb) / 0.06);filter:blur(100px)"></div>
  </div>

  <div class="wrap relative z-10">
    {/* ── AQUA TIP highlight ── */}
    <div class="reveal relative rounded-2xl overflow-hidden"
      style="background:linear-gradient(135deg,rgba(var(--accent-rgb) / 0.06),rgba(var(--accent-rgb) / 0.03));border:1px solid rgba(var(--accent-rgb) / 0.18)">

      {/* Top shimmer */}
      <div class="absolute inset-x-0 top-0 h-[1px] overflow-hidden pointer-events-none">
        <div class="tip-shimmer h-full w-[200%]"
          style="background:linear-gradient(90deg,transparent 0%,var(--accent) 25%,var(--accent-light) 50%,var(--accent) 75%,transparent 100%)"></div>
      </div>

      <div class="relative z-10 px-8 py-10 md:px-12">
        <div class="flex flex-col lg:flex-row items-start lg:items-center gap-10">

          {/* Left: copy */}
          <div class="flex-1">
            {/* Badge */}
            <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 mb-5"
              style="background:rgba(var(--accent-rgb) / 0.08);border:1px solid rgba(var(--accent-rgb) / 0.22)">
              <Icon name="lucide:zap" class="w-3.5 h-3.5" style="color:var(--accent)" />
              <span class="text-[11px] font-bold uppercase tracking-wider" style="color:var(--accent-hover)">
                Real-Time Threat Intelligence
              </span>
            </div>

            <p class="text-[11px] font-bold uppercase tracking-widest mb-1"
              style="color:rgba(var(--accent-rgb) / 0.40)">
              Standalone Product
            </p>

            <h3 class="font-extrabold tracking-tight leading-tight mb-3"
              style="font-size:clamp(22px,2.8vw,34px);color:var(--text)">
              Know Your Threats<br/>
              <span style="background:linear-gradient(135deg,var(--accent) 0%,var(--accent) 50%,var(--accent-hover) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
                Before They Strike
              </span>
            </h3>

            <p class="text-[14px] leading-[1.75] mb-5 max-w-[480px]"
              style="color:rgba(var(--text-rgb) / 0.60)">
              Real-time IP reputation intelligence powered by global threat feeds.
              Identify malicious actors before they compromise your infrastructure.
            </p>

            <p class="text-[13px] mb-6" style="color:rgba(var(--accent-rgb) / 0.50)">
              Start with{' '}
              <span style="color:var(--accent);font-weight:700">1 free search per day</span>
              . No credit card required.
            </p>

            <div class="flex flex-wrap gap-3">
              <a
                href="https://tip.aquasecure.ai"
                target="_blank" rel="noopener noreferrer"
                class="tip-btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-[14px] text-white"
                style="background:linear-gradient(135deg,var(--accent),var(--accent-hover));box-shadow:0 4px 18px rgba(var(--accent-rgb) / 0.28)">
                AQUA TIP <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </a>
              <a
                href="https://tip.aquasecure.ai"
                target="_blank" rel="noopener noreferrer"
                class="tip-btn-outline inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-[14px]"
                style="background:rgba(var(--accent-rgb) / 0.06);border:1px solid rgba(var(--accent-rgb) / 0.22);color:var(--accent-hover)">
                View Pricing <Icon name="lucide:external-link" class="w-4 h-4" />
              </a>
            </div>
          </div>

          {/* Right: 3 feature cards */}
          <div class="flex flex-col gap-3 w-full lg:w-[300px] flex-shrink-0">
            {
              features.map((f, i) => (
                <div
                  class={`tip-card reveal delay-${i + 1} flex items-start gap-3 rounded-xl p-4 border transition-all duration-200`}
                  style={`background:var(--surface);border-color:rgba(var(--accent-rgb) / 0.14);box-shadow:0 2px 12px rgba(var(--accent-rgb) / 0.06);--hover-border:${f.color}40;--hover-shadow:${f.color}18`}>
                  <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                    style={`background:${f.bg}`}>
                    <Icon name={f.icon} class="w-4 h-4" style={`color:${f.color}`} />
                  </div>
                  <div>
                    <p class="text-[13px] font-semibold mb-0.5" style="color:var(--text)">
                      {f.title}
                    </p>
                    <p class="text-[11px] leading-snug" style="color:rgba(var(--text-rgb) / 0.55)">
                      {f.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {/* Decorative glows */}
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full pointer-events-none"
        style="background:rgba(var(--accent-rgb) / 0.08);filter:blur(50px)"></div>
      <div class="absolute -bottom-16 -left-16 w-48 h-48 rounded-full pointer-events-none"
        style="background:rgba(var(--accent-rgb) / 0.06);filter:blur(50px)"></div>
    </div>

  </div>
</section>

<style>
  @keyframes tipShimmer {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0%); }
  }
  .tip-shimmer { animation: tipShimmer 3s linear infinite; }

  .tip-btn-primary { transition: transform .15s, box-shadow .15s; }
  .tip-btn-primary:hover { transform: scale(1.04); box-shadow: 0 6px 28px rgba(var(--accent-rgb) / 0.40); }
  .tip-btn-primary:active { transform: scale(0.97); }

  .tip-btn-outline { transition: transform .15s, background .15s, border-color .15s; }
  .tip-btn-outline:hover { transform: scale(1.04); background: rgba(var(--accent-rgb) / 0.14); border-color: rgba(var(--accent-rgb) / 0.42); }
  .tip-btn-outline:active { transform: scale(0.97); }

  .tip-card:hover { border-color: var(--hover-border); box-shadow: 0 4px 20px var(--hover-shadow); }
</style>

<script>
  function initIntegrations() {
    const root = document.getElementById('integrations');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
  }
  initIntegrations();
  document.addEventListener('astro:page-load', initIntegrations);
</script>
