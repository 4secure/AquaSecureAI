---
// Footer — from the AquaSecure Home design.
const products = [
  ['Aqua SIEM', '/products/siem'], ['SOC', '/products/soc'],
  ['Threat Intelligence', '/products/threat-intel'], ['Dark Web', '/products/dark-web'], ['GRC', '/products/grc'],
];
const solutions = [
  ['Manage SIEM', '/solutions/manage-siem'], ['Attack Surface', '/solutions/attack-surface'],
  ['DMARC', '/solutions/dmarc'], ['Compliance Management', '/solutions/compliance-management'],
];
const company = [
  ['Platform', '/platform'], ['Pricing', '/pricing'], ['Contact', '/contact'],
  ['AQUA TIP', 'https://tip.aquasecure.ai'],
];
---
<footer class="d-foot">
  <div class="d-foot-wrap">
    <div class="d-foot-grid">
      <div>
        <img class="d-logo d-logo-light" src="/images/aquasecure_logo1.png" alt="Aqua Secure AI" />
        <img class="d-logo d-logo-dark" src="/images/Aquasecure_logo3.png" alt="Aqua Secure AI" />
        <p class="d-foot-tag">The pioneer in AI-native cloud security. Stop threats in under 50ms — from code to cloud to prompt.</p>
        <p class="d-foot-managed">Managed services available · <a href="mailto:info@aquasecure.ai">info@aquasecure.ai</a></p>
      </div>
      <div>
        <p class="d-foot-head">Products</p>
        <div class="d-foot-links">{products.map(([l, h]) => <a href={h}>{l}</a>)}</div>
      </div>
      <div>
        <p class="d-foot-head">Solutions</p>
        <div class="d-foot-links">{solutions.map(([l, h]) => <a href={h}>{l}</a>)}</div>
      </div>
      <div>
        <p class="d-foot-head">Company</p>
        <div class="d-foot-links">{company.map(([l, h]) => <a href={h}>{l}</a>)}</div>
      </div>
    </div>
    <div class="d-foot-bottom">
      <p>© 2026 Aqua Secure AI. All rights reserved.</p>
      <div class="d-foot-badges">
        <span>ISO 27001</span>
        <span>SOC 2</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .d-foot { background: var(--surface); border-top: 1px solid var(--border); padding: 56px 0 30px; }
  .d-foot-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .d-foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 36px; }
  .d-logo { height: 32px; width: auto; margin-bottom: 16px; }
  .d-logo-light { filter: brightness(0.15) saturate(2); }
  .d-logo-dark { display: none; }
  :global(html.dark) .d-logo-light { display: none; }
  :global(html.dark) .d-logo-dark { display: block; filter: none; }
  .d-foot-tag { font-size: 14px; line-height: 1.7; color: var(--text-2); max-width: 320px; }
  .d-foot-managed { font-size: 13px; color: var(--text-3); margin-top: 14px; }
  .d-foot-managed a, .d-foot a { color: var(--accent); }
  .d-foot-head { font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--text-3); margin-bottom: 14px; }
  .d-foot-links { display: flex; flex-direction: column; gap: 9px; }
  .d-foot-links a { font-size: 14px; color: var(--text-2); transition: color .15s; }
  .d-foot-links a:hover { color: var(--accent); }
  .d-foot-bottom { margin-top: 40px; padding-top: 22px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  .d-foot-bottom p { font-size: 13px; color: var(--text-3); }
  .d-foot-badges { display: flex; gap: 8px; }
  .d-foot-badges span { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: rgba(var(--accent-rgb)/0.08); color: var(--accent); border: 1px solid rgba(var(--accent-rgb)/0.2); }
  @media (max-width: 820px) { .d-foot-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
  @media (max-width: 520px) { .d-foot-grid { grid-template-columns: 1fr; } }
</style>
