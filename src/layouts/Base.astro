---
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#4FC2BB" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@500;600;700&family=Manrope:wght@500;600;700&display=swap"
    />
    <!-- Set before first paint so revealed elements never flash in at full opacity. Only
         applied when JS runs, and a watchdog clears it if the motion module fails to load,
         so content can never be stranded invisible. -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          r.classList.add('motion-ready');
          setTimeout(function () {
            r.classList.remove('motion-ready');
          }, 2500);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
